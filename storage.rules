rules_version = '2';

// Reglas de producción de Firebase Storage para neg-sst-app.
// Reconstruidas desde las reglas desplegadas (bloque `pdfs/**` de la app Flutter)
// + el bloque `lpus/**` del SIGP (F1). El bloque `pdfs/**` está gateado por
// dueño: solo el uid del segmento {userId} del path lee/escribe.
service firebase.storage {
  match /b/{bucket}/o {

    // ── C2.1 (16-ago-2026): helpers por CUSTOM CLAIM ─────────────────────────
    // Storage no puede leer Firestore (H-008): el claim {perfil, rol} que
    // deriva la CF sincronizarClaims del doc de users es el único vehículo de
    // rol aquí. La fuente AUDITABLE sigue siendo el doc de users; el claim es
    // copia derivada. Helpers NUEVOS — ningún helper/bloque existente cambia
    // de semántica salvo las 3 rutas confidenciales que estos gates cierran.
    function esInterno() {
      return request.auth != null && request.auth.token.perfil == 'interno';
    }
    function esGerenciaAdminPorClaim() {
      return esInterno()
             && request.auth.token.rol in ['gerencia_administrativa', 'admin'];
    }

    // ── App SST (Flutter): PDFs de formularios ───────────────────────────────
    // Ruta: pdfs/{obraId}/{userId}/{formId}/{tipo}_{ts}.pdf (la escribe la app).
    // Gate de dueño: autoriza el uid del SEGMENTO {userId} del path (variable
    // de ruta, no falsificable por contenido). El panel lee vía `pdf_url`
    // (download URL con token), que no pasa por estas reglas.
    match /pdfs/{obraId}/{userId}/{formId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read:  if request.auth != null && request.auth.uid == userId;
    }

    // ── SIGP (F1): Excel original de cada LPU ────────────────────────────────
    // Ruta: lpus/{clienteId}/{lpuId}/{archivo}
    // La autorización real (quién puede crear/versionar una LPU) la impone
    // Firestore sobre el doc `lpus` (puedeGestionarProyectos). Aquí basta
    // autenticación: un Excel huérfano en Storage, sin su doc LPU, es
    // inofensivo (no expone precios).
    //
    // Nota: se intentó gatear el write por rol vía cross-service rules
    // (firestore.get sobre users/{uid}.rol), pero denegaba en runtime pese a
    // rol válido (feature poco fiable). Queda como posible hardening futuro.
    match /lpus/{clienteId}/{lpuId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // ── SIGP (F1): adjuntos de solicitudes ───────────────────────────────────
    // Ruta: solicitudes/{solicitudId}/{archivo}. Mismo patrón final que LPU
    // (auth-only; el gate por rol vía cross-service quedó como hardening, H-008).
    match /solicitudes/{solicitudId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // ── SIGP (F1): fotos/planos de visitas técnicas ──────────────────────────
    // Ruta: visitas/{visitaId}/**. Auth-only (patrón final de LPU, H-008).
    match /visitas/{visitaId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // ── SIGP (F1): evidencia de aprobación / doc de licitación de cotizaciones ─
    // Ruta: cotizaciones/{cotizacionId}/**. C2.1: SOLO perfil interno (los PDFs
    // llevan precios — un residente de cliente no debe listarlos/leerlos por
    // SDK). Los links con ?token= ya compartidos NO pasan por estas reglas y
    // siguen vivos. Si un interno con token viejo queda denegado: recargar la
    // página fuerza token nuevo (ventana ≤1 h post-backfill, se cura sola).
    match /cotizaciones/{cotizacionId}/{allPaths=**} {
      allow read, write: if esInterno();
    }

    // ── SIGP (F2.1.b): adjuntos del proyecto (permisos de ingreso, etc.) ─────
    // Ruta: proyectos/{proyectoId}/**. Auth-only (patrón final de LPU, H-008).
    // Deploy APARCADO con el go-live de F2.1.
    match /proyectos/{proyectoId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // ── Compras C1: RUT y certificación bancaria de proveedores ──────────────
    // Ruta: proveedores/{proveedorId}/{rut|certificacion_bancaria}/{fileName}
    // El fileName es un UUID (paths no adivinables — mitigación H-008: el rol
    // no se puede validar aquí; la autorización real es la regla Firestore
    // del doc/subcolección que guarda la URL). Validación que SÍ funciona:
    // path scoping + tipo de archivo + tamaño.
    // C2.1: este match EXCLUYE certificacion_bancaria (en Storage basta que UN
    // match solape para conceder — el bloque dedicado de abajo es quien la
    // gobierna). El RUT queda auth-only como estaba.
    match /proveedores/{proveedorId}/{tipoDoc}/{fileName} {
      allow read: if request.auth != null
                  && tipoDoc != 'certificacion_bancaria';
      allow write: if request.auth != null
                   && tipoDoc in ['rut']
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType == 'application/pdf'
                       || request.resource.contentType.matches('image/.*'));
    }

    // ── C2.1: certificación bancaria — SOLO gerencia_administrativa + admin ──
    // El dato más sensible de Storage (hoy lo leía cualquier autenticado).
    // Espejo del sub-doc privado/datos_bancarios de Firestore (C1), ahora
    // posible en Storage gracias al claim `rol`.
    match /proveedores/{proveedorId}/certificacion_bancaria/{fileName} {
      allow read: if esGerenciaAdminPorClaim();
      allow write: if esGerenciaAdminPorClaim()
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType == 'application/pdf'
                       || request.resource.contentType.matches('image/.*'));
    }

    // ── Horario (#3, SB2): soporte de ausentismos ────────────────────────────
    // Ruta: ausentismos/{ausentismoId}/soporte/{fileName} (fileName = UUID).
    // C2.1: documentos médicos → SOLO gerencia_administrativa + admin por
    // claim (espejo de gestionaHorario() de Firestore — quien sube y gestiona
    // ausentismos). El soporte_url con ?token= del doc no pasa por aquí.
    match /ausentismos/{ausentismoId}/{tipoDoc}/{fileName} {
      allow read: if esGerenciaAdminPorClaim();
      allow write: if esGerenciaAdminPorClaim()
                   && tipoDoc in ['soporte']
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType == 'application/pdf'
                       || request.resource.contentType.matches('image/.*'));
    }

    // ── Tareas (14-ago): evidencia de cierre ─────────────────────────────────
    // Ruta: tareas/{tareaId}/evidencia/{fileName} (fileName = UUID — patrón
    // H-008: el rol no se valida aquí; la autorización real es la regla
    // Firestore de `tareas`, que exige evidencia_url al cerrar si la tarea
    // la pide).
    match /tareas/{tareaId}/{tipoDoc}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && tipoDoc in ['evidencia']
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType == 'application/pdf'
                       || request.resource.contentType.matches('image/.*'));
    }

    // ── Compras C2/C3: adjuntos de la OC ─────────────────────────────────────
    // Ruta: ordenes_compra/{ocId}/{cotizacion|soporte}/{fileName} (UUID —
    // patrón C1, H-008). 'cotizacion' = la del proveedor al emitir (C2);
    // 'soporte' = el comprobante de la compra de Marcela (C3).
    match /ordenes_compra/{ocId}/{tipoDoc}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && tipoDoc in ['cotizacion', 'soporte']
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType == 'application/pdf'
                       || request.resource.contentType.matches('image/.*'));
    }
  }
}
