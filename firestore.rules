rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────
    // HELPERS
    // ────────────────────────────────────────────────────────────────

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAuthed() {
      return request.auth != null;
    }

    // Lee el rol del usuario, con fallback al campo legacy 'role'
    // (H-002 cerrado en datos, fallback cosmético pendiente).
    function rolActual() {
      return userData().get('rol', userData().get('role', ''));
    }

    // 1. Cualquier rol con acceso al panel web (lectura general de users)
    function esPersonalPanel() {
      return isAuthed() && rolActual() in [
        'sst', 'admin',
        'gerencia_general', 'gerencia_administrativa',
        'operacion_comercial', 'auxiliar_proyectos', 'director_proyectos',
        'residente_sst', 'gestion_integral'
      ];
    }

    // residente_obra (renombrado R2, antes residente_cliente): EMPLEADO NEG
    // con acceso restringido al cliente asignado — NO un acceso del cliente.
    // REGLA OPERATIVA: este rol JAMÁS entra a un helper existente (los de
    // arriba y abajo son listas blancas de personal interno) — nace pudiendo
    // NADA y cada permiso suyo será una cita EXPLÍCITA de este helper en los
    // matches del módulo de clientes (bloque F1 aparte). El claim que se
    // evalúa aquí lo deriva la CF sincronizarClaims del doc de users (la
    // fuente auditable); regresión permanente en rolResidente.test.ts.
    function esResidenteDe(clienteId) {
      return isAuthed()
             && request.auth.token.get('perfil', '') == 'residente_obra'
             && request.auth.token.get('cliente_id', '') == clienteId
             && request.auth.token.get('cliente_id', '') != '';
    }

    // 2. Roles que administran obras y contratistas (crear/editar).
    function puedeGestionarProyectos() {
      return isAuthed() && rolActual() in [
        'admin',
        'gerencia_general',
        'operacion_comercial', 'auxiliar_proyectos', 'director_proyectos'
      ];
    }

    // ── Aprobación de preliquidación con respaldo (23-jul-2026) ──
    // ¿Este write FIJA una aprobación? (escribe un aprobador nuevo/distinto;
    // RETIRARLA — la reversión de la corrección del Bloque 4 — no cuenta).
    function fijaAprobacionPreliq() {
      return request.resource.data.get('preliquidacion', {}).get('aprobada_por', '') != ''
          && request.resource.data.get('preliquidacion', {}).get('aprobada_por', '')
             != resource.data.get('preliquidacion', {}).get('aprobada_por', '');
    }
    function salvedadPreliq() {
      return request.resource.data.get('preliquidacion', {}).get('salvedad', '');
    }

    // 3. Gestión OPERATIVA de técnicos en `users` (aprobar/rechazar, obras,
    //    empleador, documentos) — desde el 14-oct ACOTADA por esDocTecnico +
    //    allowlist en el match: invitar, cambiar rol y borrar son solo-admin.
    //    Ya NO gobierna `formularios`/`notificaciones` — ver
    //    puedeRevisarFormularios(). Reemplaza el viejo isSST() ampliado con
    //    gestion_integral.
    function puedeAdministrarSST() {
      return isAuthed() && rolActual() in [
        'sst', 'admin', 'gestion_integral'
      ];
    }
    // Cierre del privesc de users.rol (14-oct) — helper del Anexo A de la
    // propuesta del frente SST/SGI: un doc "es de técnico" si rol Y role
    // (rolActual() lee `rol` con fallback a `role`) son 'tecnico', con
    // default 'tecnico' para los legados que solo traen uno. Se evalúa sobre
    // resource Y request.resource: el doc debe SER técnico y SEGUIR siéndolo.
    function esDocTecnico(d) {
      return d.get('rol', 'tecnico') == 'tecnico'
          && d.get('role', 'tecnico') == 'tecnico';
    }

    // 4. Solo lectura del subsistema SST (gerencia_general con visión
    //    ejecutiva total)
    function puedeVerSSTSoloLectura() {
      return isAuthed() && rolActual() in ['gerencia_general'];
    }

    // 4.5. Revisión de la cola SST (read/update de `formularios` y
    //    `notificaciones`) ÚNICAMENTE. Deliberadamente separado de
    //    puedeAdministrarSST(), que queda acotado a la gestión de `users`:
    //    residente_sst revisa formularios sin ganar poder sobre usuarios.
    function puedeRevisarFormularios() {
      return isAuthed() && rolActual() in [
        'sst', 'admin', 'gestion_integral', 'residente_sst'
      ];
    }

    // 5. Acceso al módulo SIGP (lectura de colecciones comerciales/proyectos).
    //    Espeja ROLES_CON_ACCESO_SIGP de types/sigp/roles.ts.
    function accesoSIGP() {
      return isAuthed() && rolActual() in [
        'admin', 'gerencia_general', 'gerencia_administrativa',
        'operacion_comercial', 'director_proyectos', 'auxiliar_proyectos',
        'gestion_integral'
      ];
    }

    // 6. Módulo Compras (C1): registro de proveedores y su información
    //    bancaria. Marcela (gerencia_administrativa) opera; admin respalda.
    function gestionaCompras() {
      return isAuthed() && rolActual() in ['gerencia_administrativa', 'admin'];
    }

    // 9. Validador de horario / asistencia (#3, 07-ago): los REPORTES los
    //    ven todas las gerencias + admin (decisión Giovanny); la GESTIÓN
    //    (ausentismos, detalle médico) es solo de gerencia_administrativa +
    //    admin. Los registros de reloj no los escribe NADIE desde el panel.
    function veHorario() {
      return isAuthed() && rolActual() in [
        'gerencia_administrativa', 'gerencia_general', 'gestion_integral',
        'director_proyectos', 'admin'
      ];
    }
    function gestionaHorario() {
      return isAuthed() && rolActual() in ['gerencia_administrativa', 'admin'];
    }
    // Registrar/anular AUSENTISMOS (13-oct, OK de Giovanny): se amplía a
    // gestion_integral — Ingrid registra AT/EL (tipo incapacidad + origen,
    // dato administrativo). Helper PROPIO en vez de ampliar gestionaHorario():
    // ese gobierna también el sub-doc médico privado/detalle y los horarios
    // personales, que NO se abren. Espejo: puedeRegistrarAusentismoUI.
    function registraAusentismo() {
      return isAuthed() && rolActual() in ['gerencia_administrativa', 'gestion_integral', 'admin'];
    }
    // Regla DURA del origen ATEL (14-oct, pedido de Giovanny tras el reporte
    // del frente): para el reporte legal de ATEL, "en la práctica no hay otra
    // vía" no es una garantía — es una suposición sobre el futuro. Un doc con
    // tipo 'incapacidad' no puede EXISTIR sin origen válido: ni al nacer
    // (create) ni ENTRANDO a ese estado por update (cambiar tipo u origen
    // re-valida el invariante). Los HISTÓRICOS pre-24-sep sin origen siguen
    // anulables/editables mientras no toquen tipo/origen — la regla cierra la
    // puerta hacia el estado inválido, no castiga lo que ya existía.
    function origenAtelValido() {
      return request.resource.data.get('tipo', '') != 'incapacidad'
             || request.resource.data.get('origen', '') in ['laboral', 'comun'];
    }

    // 10. Mantenimiento de precios del catálogo NEG (#2b, 09-ago): quién
    //     CORRIGE o AJUSTA MASIVAMENTE precios ya existentes. El ALTA desde
    //     el cotizador (create) sigue abierta a puedeGestionarProyectos().
    function puedeMantenerCatalogo() {
      return isAuthed() && rolActual() in [
        'gerencia_general', 'director_proyectos', 'admin'
      ];
    }

    // 11. Módulo de ACTIVIDADES + sus propuestas económicas (F1/F1.2).
    //     Helper PROPIO del módulo (decisión de Giovanny, 18-ago-2026):
    //     operacion_comercial NO ve actividades ni propuestas — Karen está
    //     a cargo únicamente de licitaciones; la operación in-house de
    //     Claro no es su frente. Antes estas colecciones heredaban
    //     puedeGestionarProyectos() (que sí incluye comercial porque
    //     gobierna el dominio comercial); ese helper NO se toca — cada
    //     módulo trae el suyo. El residente entra por esResidenteDe.
    function gestionaActividades() {
      return isAuthed() && rolActual() in [
        'admin', 'gerencia_general', 'auxiliar_proyectos', 'director_proyectos'
      ];
    }

    // 11. Módulo Tareas (14-ago): asignar tareas A OTROS es de las gerencias
    //     + admin (misma lectura de "gerencias" que veHorario); cualquiera
    //     del panel se AUTO-asigna y pasa/recibe el balón.
    function puedeAsignarTareas() {
      return isAuthed() && rolActual() in [
        'gerencia_general', 'gerencia_administrativa',
        'director_proyectos', 'gestion_integral', 'admin'
      ];
    }

    // 7. Módulo Compras (C2): órdenes de compra — documento de EJECUCIÓN
    //    (costo operativo: jamás venta/utilidad). Lectura por lista explícita
    //    (mínimo privilegio): sin operacion_comercial ni sst — la OC no es
    //    comercial. `residente_obra` se sumará a crear/ver cuando exista el rol.
    function puedeCrearOC() {
      return isAuthed() && rolActual() in [
        'auxiliar_proyectos', 'director_proyectos', 'gerencia_general', 'admin'
      ];
    }
    function apruebaOC() {
      // LEGACY (régimen anterior a oct-2026): la aprobación previa se
      // reemplazó por la revisión de administrativa (OC2). Se conserva
      // SOLO para anular las OCs que siguen en `aprobada`.
      return isAuthed() && rolActual() in ['director_proyectos', 'gerencia_general', 'admin'];
    }
    // OC2 — el gate nuevo: REVISA gerencia_administrativa (titular) + GG y
    // admin como respaldo (respaldo que revisa lo propio → salvedad).
    function revisaOC() {
      return isAuthed() && rolActual() in ['gerencia_administrativa', 'gerencia_general', 'admin'];
    }
    // OC2 — marcar la compra pasa de Marcela a Paula: quien valida no recibe.
    function marcaCompraOC() {
      return isAuthed() && rolActual() in ['auxiliar_proyectos', 'admin'];
    }
    function puedeVerOC() {
      return isAuthed() && rolActual() in [
        'auxiliar_proyectos', 'director_proyectos', 'gerencia_general',
        'gerencia_administrativa', 'gestion_integral', 'admin'
      ];
    }
    // (OC2 paso B: fijaAprobacionOC() se retiró — la entrada a `aprobada`
    //  quedó cerrada; apruebaOC() queda SOLO para anular las legacy.)

    // 8. §16 (07-ago): la frontera de comercial es la COTIZACIÓN — los
    //    proyectos son dominio de ejecución. operacion_comercial queda fuera
    //    de LEER y de CREAR proyectos; el nacimiento es de la CF
    //    crearProyectoAlAprobar (Admin SDK, patrón 3a de único escritor).
    function puedeVerProyectos() {
      return isAuthed() && rolActual() in [
        'admin', 'gerencia_general', 'gerencia_administrativa',
        'director_proyectos', 'auxiliar_proyectos', 'gestion_integral'
      ];
    }
    // Escotilla MANUAL de creación (gestores sin comercial). El creador
    // primario es la CF; esto queda para emergencias de admin/dirección.
    function puedeCrearProyectos() {
      return isAuthed() && rolActual() in [
        'admin', 'gerencia_general', 'director_proyectos', 'auxiliar_proyectos'
      ];
    }

    // 12. Módulo LICITACIONES — helper PROPIO del módulo (misma costumbre que
    //     gestionaActividades: cada módulo trae el suyo; ningún helper
    //     existente se toca). `operacion_comercial` ESTÁ dentro: las
    //     licitaciones son su frente (decisión de negocio del PR #97).
    function gestionaLicitaciones() {
      return isAuthed() && rolActual() in [
        'operacion_comercial', 'gerencia_general', 'gerencia_administrativa',
        'director_proyectos', 'admin'
      ];
    }

    // 13. ECONOMÍA de la licitación (subcolección): oferta de NEG, márgenes,
    //     análisis del precio. SIN `operacion_comercial` — quien arma la
    //     propuesta no ve el techo económico con el que se la evalúa. Mismo
    //     principio de mínimo privilegio que puedeVerOC.
    function veEconomiaLicitacion() {
      return isAuthed() && rolActual() in [
        'gerencia_general', 'gerencia_administrativa', 'director_proyectos',
        'admin'
      ];
    }

    // 14. Escritura del REGISTRO DEL CRITERIO del semáforo
    //     (`configuracion/semaforo_versiones`). Segregación de funciones:
    //     `operacion_comercial` LEE el criterio (vía el read de
    //     `configuracion/{docId}`) y no lo ESCRIBE — quien es medido por el
    //     criterio no lo redefine.
    //     `gerencia_administrativa` quedó FUERA (corrección 23-oct-2026):
    //     el criterio con que se mide un proceso público es conocimiento del
    //     área de licitaciones, no trabajo administrativo. Entra
    //     `director_proyectos`, que sí lo es. Reducción de superficie sobre
    //     un rol de otro frente — avisada, no silenciosa.
    function escribeCriterioSemaforo() {
      return isAuthed() && rolActual() in [
        'gerencia_general', 'director_proyectos', 'admin'
      ];
    }

    // 14-bis. Quién EDITA la plantilla de requisitos del pliego típico
    //     (`configuracion/plantilla_requisitos`, A.2a). Misma lista que
    //     escribeCriterioSemaforo HOY, pero helper PROPIO a propósito: son
    //     dos preguntas distintas (quién define el criterio con que se mide
    //     un proceso / quién define la lista de lo que un pliego suele
    //     pedir), y si algún día una de las dos cambia, se cambia sola y no
    //     por cirugía sobre la otra.
    //     `operacion_comercial` TRABAJA CONTRA la plantilla y no la edita:
    //     quien es medido por una lista no la redefine.
    //     `gerencia_administrativa` está FUERA por la misma razón que en el
    //     criterio: la plantilla de requisitos de pliego es conocimiento del
    //     área de licitaciones, no trabajo administrativo.
    //     La LECTURA la da el match genérico de `configuracion/{docId}`
    //     (accesoSIGP) — la plantilla no tiene nada reservado.
    function editaPlantillaRequisitos() {
      return isAuthed() && rolActual() in [
        'gerencia_general', 'director_proyectos', 'admin'
      ];
    }

    // 15. Invariante 6 de licitaciones: los estados de COMPROMISO (donde NEG
    //     gasta horas) y los de RESULTADO exigen consecutivo. Los tres de
    //     triage — detectada, en_evaluacion, descartada — lo admiten vacío.
    //     Espeja ESTADOS_EXIGEN_CONSECUTIVO de types/sigp/licitacion.ts.
    function licExigeConsecutivo(estado) {
      return estado in [
        'en_preparacion', 'manifestada', 'presentada',
        'adjudicada', 'perdida', 'rechazada', 'revocada', 'desierta'
      ];
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: users
    // ────────────────────────────────────────────────────────────────

    match /users/{userId} {
      // Read: uno mismo, o cualquier rol con acceso al panel
      allow read: if isAuthed() && (
        request.auth.uid == userId || esPersonalPanel()
      );

      // Update self: puede editar su propio documento, pero NO cambiar
      // campos sensibles.
      // 22-sep (PR B nómina): `empleador_verificacion` la escribe SOLO la
      // CF emparejarNomina (Admin SDK) y `contratista_id/nombre` dejan de
      // ser editables por el propio usuario — un dato "verificado contra
      // la nómina" que el usuario pudiera reescribir sería evidencia
      // falsificable. La app solo los escribe en el CREATE del registro
      // (verificado contra el código Dart: el único self-update de la app
      // es `documentos`); escribirlos con el MISMO valor sigue pasando
      // (affectedKeys = solo lo que cambia).
      allow update: if isAuthed()
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data)
                        .affectedKeys()
                        // 14-oct (G1/M1 de la revisión Opus del cierre del
                        // privesc): += cliente_id (un residente podía AUTO-
                        // reasignarse de cliente — la CF copia el claim y le
                        // abre los datos del otro cliente: acceso cruzado) y
                        // += cedula (un técnico podía reescribir su cédula y
                        // el emparejamiento de nómina lo "verificaba" contra
                        // la cédula que él mismo puso). El self-update vivo
                        // de la app es SOLO `documentos` — nada se rompe.
                        .hasAny(['rol', 'role', 'estado', 'aprobado', 'obras_asignadas',
                                 'contratista_id', 'contratista_nombre', 'empleador_verificacion',
                                 'cliente_id', 'cedula']);

      // Create/update/delete administrativo (REESCRITO 14-oct — cierre del
      // PRIVESC de users.rol, el residual que el frente SGI/SST nombró en su
      // aviso de ventana: mientras sst/gestion_integral pudieran escribir
      // CUALQUIER campo de CUALQUIER usuario — incluido su propio rol —,
      // todo control "solo gestion_integral" o "solo admin" del sistema era
      // falsificable por escalada previa):
      //  · admin: create/update/delete totales (⇄Rol, ✎Firma e Invitar ya
      //    eran admin-only en UI; los roles SIGP se cambian por consola —
      //    tocarlos desde el panel rompería claims).
      //  · sst/gestion_integral: SOLO la gestión operativa de técnicos, por
      //    ALLOWLIST censada contra el panel Y el código Dart de la app
      //    (aprobar/rechazar/restaurar/activar/desactivar · obras + empleador
      //    · vencimientos del panel · mapa `documentos` que la app escribe).
      //    JAMÁS rol/role — el privesc queda cerrado A NIVEL DE REGLAS.
      //    `crearUsuario()` de la app es código muerto (definido, nunca
      //    llamado — verificado 14-oct): el create se acota sin romperla.
      // FORMULACIÓN COMBINADA (14-oct): el Anexo A del frente (esDocTecnico —
      // sst/GI solo tocan docs que SON técnico y SIGUEN siéndolo) + la
      // allowlist de campos censada contra panel y app. Cada pata cierra lo
      // que la otra deja: sin esDocTecnico, la allowlist permitiría
      // desactivar PERSONAL (estado es campo legítimo pero el doc no);
      // sin la allowlist, esDocTecnico permitiría falsificar
      // empleador_verificacion o suplantar nombre/email de un técnico.
      allow create, delete: if isAuthed() && rolActual() == 'admin';
      allow update: if isAuthed() && rolActual() == 'admin';
      allow update: if puedeAdministrarSST()
                    && esDocTecnico(resource.data)
                    && esDocTecnico(request.resource.data)
                    && request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['estado', 'fecha_aprobacion', 'rechazo',
                                  'obras_asignadas', 'contratista_id', 'contratista_nombre',
                                  'eps_vencimiento', 'arl_vencimiento', 'pension_vencimiento',
                                  'documentos']);

      // Create self: al registrarse en la app, SOLO puede crear su propio doc
      // con rol 'tecnico', estado 'pendiente', sin auto-aprobarse y sin
      // auto-asignarse obras (allowlist, no denylist — cierra el hueco de
      // auto-asignarse cualquier rol privilegiado, de saltarse la cola de
      // aprobación SST vía estado/aprobado, o de precargar obras propias).
      allow create: if isAuthed()
                    && request.auth.uid == userId
                    && request.resource.data.get('rol', 'tecnico') == 'tecnico'
                    && request.resource.data.get('role', 'tecnico') == 'tecnico'
                    && request.resource.data.get('estado', 'pendiente') == 'pendiente'
                    && request.resource.data.get('aprobado', false) == false
                    && request.resource.data.get('obras_asignadas', []) == [];
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: obras
    // ────────────────────────────────────────────────────────────────

    match /obras/{obraId} {
      // Read: cualquier usuario autenticado (comportamiento legacy). El panel
      // SST (hub de registros), la app Flutter y la sincronización de la
      // obra-espejo necesitan listar/leer obras. NO se toca (Hotfix A).
      allow read: if isAuthed();

      // Hotfix A (23-jul-2026): las obras NACEN del flujo SIGP (obra-espejo
      // con origen:'sigp' al entrar el proyecto en ejecución). La creación
      // manual suelta queda restringida a admin (escotilla de emergencia):
      // un gestor solo puede crear la espejo del flujo.
      allow create: if isAuthed() && (
        rolActual() == 'admin' ||
        (puedeGestionarProyectos() && request.resource.data.get('origen', '') == 'sigp')
      );

      // Update/delete: gestión de proyectos (la sincronización de la espejo
      // actualiza el estado en las transiciones del proyecto).
      allow update, delete: if puedeGestionarProyectos();
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: contratistas
    // ────────────────────────────────────────────────────────────────
    // Lectura pública justificada: el formulario de registro de
    // técnicos en la app SST necesita listar contratistas pre-login
    // (el selector solo muestra el nombre). C2.1 paso 5 — cierre
    // PARCIAL de H-001: la CÉDULA (dato personal, Ley 1581/2012) vive
    // en el sub-doc privado/datos y NO en este doc público; el NIT se
    // queda en el padre como riesgo aceptado (registro mercantil
    // público — y la app Flutter lo lee/escribe, línea roja no tocar).

    match /contratistas/{contratistaId} {
      allow read: if true;

      // ── MODELO DEL AVAL (22-sep, decisión Giovanny) ──
      // INSCRIBIR (crear): gestores + gestion_integral — la Caracterización
      // asigna el aval de la inscripción al SGI e Ingrid también inscribe.
      // EL CONTRATISTA NACE INACTIVO (22-sep, cierre del hueco de la puerta
      // de entrada): si el estado inicial fuera libre, todo el control del
      // aval sería evitable — bastaría nacer habilitado sin pasar por GI.
      // Con este guard, "¿quién avaló a este contratista y cuándo?" SIEMPRE
      // tiene respuesta: nadie puede nacer avalado; el aval es un acto
      // separado y deliberado (el toggle trazado), jamás un default.
      // 📓 BITÁCORA: la traza rige desde el 22-sep-2026 — los 11
      // contratistas existentes conservan su estado SIN registro de quién
      // los avaló porque son anteriores al control; historia aceptada, no
      // se inventa retroactivamente.
      // C2.1 paso 5 fase 3: el padre RECHAZA los campos de datos personales
      // en create y update — aunque un formulario futuro se equivoque, la
      // cédula no puede volver al doc público.
      allow create: if (puedeGestionarProyectos()
                        || (isAuthed() && rolActual() == 'gestion_integral'))
                    && request.resource.data.get('estado', '') == 'inactivo'
                    && !request.resource.data.keys()
                        .hasAny(['cedula', 'telefono', 'direccion']);
      // EDITAR (gestores): `estado` queda FUERA de esta vía — habilitar es
      // exclusivamente el aval (titular/respaldo, abajo), patrón del BONUS
      // del aprobador de respaldo de preliquidaciones (PR #45). Editar sin
      // cambiar el estado pasa igual (affectedKeys = solo lo que CAMBIA).
      // 14-oct (OK de Giovanny, hallazgo del barrido de GI): quien INSCRIBE
      // corrige — gestion_integral edita la identidad con el MISMO guard de
      // campos vedados (la cédula no vuelve al doc público; el estado sigue
      // siendo exclusivamente el aval). La traza de quién corrigió qué la
      // escribe la UI en historial[] (entradaCorreccionIdentidad). Verificado
      // antes de abrir: el NIT solo vive aquí — aguas abajo hay copias
      // CONGELADAS deliberadas (asignacion.contratista_documento) que no
      // deben seguirlo. DELETE no se amplía.
      allow update: if (puedeGestionarProyectos()
                        || (isAuthed() && rolActual() == 'gestion_integral'))
                    && !request.resource.data.diff(resource.data)
                        .affectedKeys().hasAny(['cedula', 'telefono', 'direccion', 'estado']);
      allow delete: if puedeGestionarProyectos();

      // C2.1 paso 5: datos personales del contratista (cédula de persona
      // natural) — patrón sub-doc privado de proveedores (C1). Leen quienes
      // gestionan proyectos (asignación congela el documento), gerencia
      // administrativa (tabla / habilitación) y gestion_integral (dueña del
      // registro de proveedores); escriben los gestores y gestion_integral
      // (22-sep: inscribir a un natural incluye su cédula — mismo camino
      // del CRUD del padre).
      match /privado/{docId} {
        allow read: if puedeGestionarProyectos() || gestionaCompras()
                    || (isAuthed() && rolActual() == 'gestion_integral');
        allow write: if puedeGestionarProyectos()
                     || (isAuthed() && rolActual() == 'gestion_integral');
      }

      // ── HABILITAR (el aval) — titular y respaldo (22-sep) ──
      // La entrada de traza que este write agrega al historial: el rastro de
      // autoría es parte del MISMO write (quién, cuándo, y la salvedad si es
      // de respaldo) y las vías lo EXIGEN — append-only, sin suplantación.
      function entradaAvalContratista() {
        return request.resource.data.historial[request.resource.data.historial.size() - 1];
      }
      function escribeAvalTrazado() {
        return request.resource.data.diff(resource.data)
                   .affectedKeys().hasOnly(['estado', 'fecha_actualizacion', 'historial'])
               && request.resource.data.diff(resource.data)
                   .affectedKeys().hasAll(['estado', 'historial'])
               && request.resource.data.historial.size()
                   > resource.data.get('historial', []).size()
               && entradaAvalContratista().por == request.auth.uid;
      }
      // TITULAR: gestion_integral — la Caracterización asigna la habilitación
      // de contratistas al SGI (restaurada en PR #110; segunda contradicción
      // módulo-vs-Caracterización, la primera fue la verificación SST).
      allow update: if isAuthed()
                    && rolActual() == 'gestion_integral'
                    && escribeAvalTrazado();
      // RESPALDO: gerencia_general, gerencia_administrativa (titular hasta
      // este modelo — pasó a respaldo, no se quitó) y admin — SIEMPRE con
      // salvedad escrita en la entrada de traza (por qué no avaló el
      // titular). Patrón del aprobador de respaldo de preliquidaciones:
      // la traza distingue el aval normal del aval por excepción.
      allow update: if isAuthed()
                    && rolActual() in ['gerencia_administrativa', 'gerencia_general', 'admin']
                    && escribeAvalTrazado()
                    && entradaAvalContratista().get('salvedad', '') != '';
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: registros — INMUTABLE (auditoría a prueba de manipulación)
    // ────────────────────────────────────────────────────────────────

    match /registros/{registroId} {
      allow read: if isAuthed() && (
        puedeAdministrarSST() ||
        puedeVerSSTSoloLectura() ||
        resource.data.get('tecnicoId', '') == request.auth.uid
      );
      allow create: if isAuthed();
      allow update, delete: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: formularios
    // ────────────────────────────────────────────────────────────────

    match /formularios/{formularioId} {
      allow read: if isAuthed() && (
        puedeRevisarFormularios() ||
        puedeVerSSTSoloLectura() ||
        resource.data.get('user_id', '') == request.auth.uid
      );

      allow create: if isAuthed() &&
        request.resource.data.get('user_id', '') == request.auth.uid;

      // Update — dos vías:
      // 1) Revisores (puedeRevisarFormularios): sin restricción — son los
      //    ÚNICOS que fijan revision_sst.estado en 'aprobado'/'rechazado'.
      // 2) El DUEÑO del formulario (la app móvil): sus updates normales
      //    (guardar `data`, actualizar `pdf_url`/`pdf_storage_path`, etc.)
      //    siguen libres como siempre; PERO si el update toca `revision_sst`,
      //    el nuevo `revision_sst.estado` tiene que ser exactamente
      //    'pendiente'. El único caso legítimo de que el dueño toque
      //    `revision_sst` es el reenvío tras corrección (#4): la app escribe
      //    revision_sst → {estado:'pendiente', observacion:null,
      //    revisado_por:null} + corregido_en (+ revision_sst_historial via
      //    arrayUnion). Esto cierra el hueco de que un técnico pudiera
      //    auto-fijarse revision_sst.estado = 'aprobado' (auto-aprobación).
      allow update: if isAuthed() && (
        puedeRevisarFormularios() ||
        (resource.data.get('user_id', '') == request.auth.uid
          && (!request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['revision_sst'])
              || request.resource.data.get('revision_sst', {})
                   .get('estado', '') == 'pendiente'))
      );

      allow delete: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: contadores — consecutivos atómicos SST (app móvil)
    // ────────────────────────────────────────────────────────────────
    // Sin cambio. Sistema legacy de la app Flutter.

    match /contadores/{clave} {
      allow read, create, update: if isAuthed();
      allow delete: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: notificaciones — panel SST ↔ app móvil
    // ────────────────────────────────────────────────────────────────

    match /notificaciones/{notifId} {
      allow read: if isAuthed() && (
        puedeRevisarFormularios() ||
        puedeVerSSTSoloLectura() ||
        resource.data.get('user_id', '') == request.auth.uid
      );

      allow create: if isAuthed();

      allow update: if isAuthed() && (
        puedeRevisarFormularios() ||
        resource.data.get('user_id', '') == request.auth.uid
      );

      allow delete: if puedeAdministrarSST();
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: clientes (SIGP — Comercial, F1)
    // ────────────────────────────────────────────────────────────────
    // Read: cualquier rol con acceso al módulo SIGP.
    // Write: solo roles que gestionan proyectos/comercial.

    match /clientes/{clienteId} {
      // F1 Actividades: el residente lee SU cliente (sedes, solicitantes,
      // contratos — los necesita para operar actividades). Concesión
      // explícita vía esResidenteDe; jamás la lista interna.
      allow read: if accesoSIGP() || esResidenteDe(clienteId);
      allow create, update, delete: if puedeGestionarProyectos();
    }

    // ── Compras C1: proveedores (los materiales los compra NEG) ──────
    // Doc id = identificación normalizada. Identidad + rut_url visibles a
    // los operativos (C2: órdenes de compra); lo bancario VIVE en la
    // subcolección privada — las reglas no ocultan campos en lectura
    // (mismo principio que la proyección verificaciones_sst del 3a).
    // Sin delete: soft-delete por estado (restricción 5.1).
    match /proveedores/{proveedorId} {
      allow read: if accesoSIGP();
      // Proveedor nuevo exige el RUT ya subido (validación dura UI + regla).
      allow create: if gestionaCompras()
                    && request.resource.data.get('rut_url', '') != '';
      allow update: if gestionaCompras();

      // Datos bancarios + certificación bancaria: SOLO gerencia_administrativa
      // y admin (ni lectura para el resto del panel). El create exige cert +
      // banco + cuenta (sin cuenta no se le puede pagar); tipo_cuenta es duro
      // solo en UI. La creación ATÓMICA doc principal + este doc (un batch)
      // es responsabilidad del flujo de registro (C1 sub-bloque 2).
      match /privado/{docId} {
        allow read: if gestionaCompras();
        allow create: if gestionaCompras()
                      && request.resource.data.get('certificacion_bancaria_url', '') != ''
                      && request.resource.data.get('banco', '') != ''
                      && request.resource.data.get('numero_cuenta', '') != '';
        allow update: if gestionaCompras();
      }
    }

    // ── Compras C1: semilla de autocompletado de contactos ───────────
    // Solo lectura para quien registra proveedores; SIN write en reglas.
    // Se poblará más adelante con un wizard manual desde un Excel filtrado
    // (el seed por script se retiró del alcance de C1).
    match /contactos_lookup/{contactoId} {
      allow read: if gestionaCompras();
    }

    // ── Compras C2: órdenes de compra ────────────────────────────────
    // El consecutivo OC-YYYY-NNN se asigna al EMITIR (los borradores no
    // queman número — contigüidad ISO). La aprobación está blindada
    // por-campo: rol aprobador + aprobador ≠ creador (o salvedad
    // obligatoria — el escape GG-crea/GG-aprueba, con traza).
    match /ordenes_compra/{ocId} {
      allow read: if puedeVerOC();
      // Nace SIEMPRE como borrador y con el creador real (no suplantable).
      allow create: if puedeCrearOC()
                    && request.resource.data.get('estado', '') == 'borrador'
                    && request.resource.data.get('creada_por', '') == request.auth.uid;
      // Vías (C3 + OC2): la OPERATIVA (crear/emitir/re-enviar/anular), la de
      // REVISIÓN (OC2 — validar/devolver/anular revisadas), la de COMPRA
      // (OC2 — Paula marca comprada + corrige) y la de MARCELA (C3 — queda
      // viva durante el paso A del despliegue mixto; sale en el paso B).
      allow update: if (
                    // ── Vía OPERATIVA ──
                    puedeCrearOC()
                    // comprada = terminal para operativos (recepción = v2)
                    && resource.data.get('estado', '') != 'comprada'
                    && request.resource.data.get('estado', '') != 'comprada'
                    // aprobada = inmutable, salvo ANULARLA (solo aprobadores)
                    && (resource.data.get('estado', '') != 'aprobada'
                        || (apruebaOC() && request.resource.data.get('estado', '') == 'anulada'))
                    // anulada = terminal
                    && resource.data.get('estado', '') != 'anulada'
                    // OC2: el gate no se salta por la vía operativa — ENTRAR
                    // a revisada/rechazada es solo de la vía de revisión
                    // (editar una que YA está ahí no es entrar: patrón del
                    // guard de aprobada; lo atrapó la batería)
                    && (request.resource.data.get('estado', '') != 'revisada'
                        || resource.data.get('estado', '') == 'revisada')
                    && (request.resource.data.get('estado', '') != 'rechazada'
                        || resource.data.get('estado', '') == 'rechazada')
                    // OC2: revisada = inmutable por esta vía, salvo que su
                    // CREADOR la anule
                    && (resource.data.get('estado', '') != 'revisada'
                        || (request.resource.data.get('estado', '') == 'anulada'
                            && request.auth.uid == resource.data.get('creada_por', '')))
                    // OC2: una DEVUELTA la toca solo quien la creó (o admin) —
                    // editarla, re-enviarla (→ emitida) o anularla
                    && (resource.data.get('estado', '') != 'rechazada'
                        || request.auth.uid == resource.data.get('creada_por', '')
                        || rolActual() == 'admin')
                    // EMITIR (y RE-ENVIAR) exige la cotización del proveedor adjunta
                    && (request.resource.data.get('estado', '') != 'emitida'
                        || resource.data.get('estado', '') == 'emitida'
                        || request.resource.data.get('cotizacion_proveedor_url', '') != '')
                    // OC2 paso B: `aprobada` CERRADA a entradas — es el
                    // estado LEGACY del régimen anterior; el gate vigente es
                    // la revisión (vía de abajo). Editar/anular las que ya
                    // están ahí lo gobierna el guard de inmutabilidad de
                    // arriba (solo apruebaOC() las anula).
                    && (request.resource.data.get('estado', '') != 'aprobada'
                        || resource.data.get('estado', '') == 'aprobada')
                    ) || (
                    // ── Vía REVISIÓN (OC2): emitida → revisada|rechazada, con
                    // hasOnly. Validar exige el total LEÍDO de la cotización
                    // del proveedor (>0 — el acto de mirar); devolver exige
                    // motivo; respaldo que valida lo propio → salvedad.
                    revisaOC()
                    && resource.data.get('estado', '') == 'emitida'
                    && request.resource.data.get('estado', '') in ['revisada', 'rechazada']
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['estado', 'revision', 'rechazo', 'historial', 'fecha_actualizacion'])
                    && (request.resource.data.get('estado', '') != 'revisada'
                        || (request.resource.data.get('revision', {}).get('total_cotizacion_proveedor', 0) > 0
                            && (request.auth.uid != resource.data.get('creada_por', '')
                                || request.resource.data.get('revision', {}).get('salvedad', '') != '')))
                    && (request.resource.data.get('estado', '') != 'rechazada'
                        || request.resource.data.get('rechazo', {}).get('motivo', '') != '')
                    ) || (
                    // ── Vía REVISIÓN (OC2): anular una revisada (con motivo
                    // en el historial — hasOnly acotado).
                    revisaOC()
                    && resource.data.get('estado', '') == 'revisada'
                    && request.resource.data.get('estado', '') == 'anulada'
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['estado', 'historial', 'fecha_actualizacion'])
                    ) || (
                    // ── Vía COMPRA (OC2 — Paula): revisada (régimen nuevo) o
                    // aprobada (legacy) → comprada, valor real + soporte
                    // obligatorios; y la corrección comprada→comprada con
                    // traza (calco de la vía de Marcela, que sale en paso B).
                    marcaCompraOC()
                    && resource.data.get('estado', '') in ['revisada', 'aprobada']
                    && request.resource.data.get('estado', '') == 'comprada'
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['estado', 'valor_real', 'soporte_compra_url',
                                  'comprada_por', 'fecha_compra', 'historial',
                                  'fecha_actualizacion'])
                    && request.resource.data.get('valor_real', 0) > 0
                    && request.resource.data.get('soporte_compra_url', '') != ''
                    ) || (
                    marcaCompraOC()
                    && resource.data.get('estado', '') == 'comprada'
                    && request.resource.data.get('estado', '') == 'comprada'
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['valor_real', 'soporte_compra_url',
                                  'historial', 'fecha_actualizacion'])
                    && request.resource.data.get('valor_real', 0) > 0
                    );
                    // (OC2 paso B: las vías de MARCELA del C3 — comprar y
                    //  corregir — se retiraron: la compra es de Paula
                    //  (marcaCompraOC, arriba). Quien valida no recibe.)
      // sin delete — 'anulada' es el terminal suave (restricción 5.1)
    }

    // ── Compras C3: proyección del agregado de compras por proyecto ──
    // La escribe SOLO la CF sincronizarComprasProyecto (Admin SDK) — sin
    // ningún write de cliente: a prueba de manipulación por construcción
    // (patrón verificaciones_sst). Alimenta el indicador presupuestal (#3).
    // Lectura alineada con las OCs (§16/C2): sin sst ni operacion_comercial.
    match /compras_proyecto/{proyectoId} {
      allow read: if puedeVerOC();
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: lpus (+ subcolección items) — SIGP, Comercial, F1
    // ────────────────────────────────────────────────────────────────
    // Read: cualquier rol con acceso SIGP. Write: gestión de proyectos.
    // Los ítems (~900 por LPU) viven en la subcolección lpus/{id}/items.

    match /lpus/{lpuId} {
      // F1 Actividades: el residente lee las LPUs de SU cliente (el buscador
      // de líneas del alcance). El list exige where cliente_id == el suyo.
      allow read: if accesoSIGP() || esResidenteDe(resource.data.cliente_id);
      allow create, update, delete: if puedeGestionarProyectos();

      match /items/{itemId} {
        // Los ítems no llevan cliente_id: se resuelve por el doc PADRE
        // (get cacheado por request — un solo doc único por consulta).
        allow read: if accesoSIGP()
                    || esResidenteDe(get(/databases/$(database)/documents/lpus/$(lpuId)).data.cliente_id);
        allow create, update, delete: if puedeGestionarProyectos();
      }
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: solicitudes (SIGP — Comercial, F1)
    // ────────────────────────────────────────────────────────────────
    // Bandeja de entrada comercial. Read: acceso SIGP. Write: gestión de proyectos.

    match /solicitudes/{solicitudId} {
      allow read: if accesoSIGP();
      allow create, update, delete: if puedeGestionarProyectos();
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: visitas (SIGP — Comercial, F1 — levantamiento)
    // ────────────────────────────────────────────────────────────────
    // Read: acceso SIGP. Write: gestión de proyectos.

    match /visitas/{visitaId} {
      allow read: if accesoSIGP();
      allow create, update, delete: if puedeGestionarProyectos();
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: cotizaciones (+ subcolección versiones) — SIGP, Comercial, F1
    // ────────────────────────────────────────────────────────────────
    // Read: acceso SIGP. Write: gestión de proyectos. Cada versión (snapshot con
    // ítems inline) vive en la subcolección cotizaciones/{id}/versiones.

    match /cotizaciones/{cotizacionId} {
      allow read: if accesoSIGP();
      allow create, update, delete: if puedeGestionarProyectos();

      match /versiones/{versionId} {
        allow read: if accesoSIGP();
        allow create, update, delete: if puedeGestionarProyectos();
      }
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: catalogo_items — catálogo NEG de ítems propios (F1.4-B)
    // ────────────────────────────────────────────────────────────────
    // Read: acceso SIGP. Write: gestión de proyectos. El código CAT-NNNN lo
    // genera la Cloud Function generarConsecutivo (contador acumulativo).

    // #2b (09-ago): el ALTA sigue siendo del cotizador (incorporación con
    // CAT-NNNN — un setDoc sobre doc NUEVO, jamás update); el MANTENIMIENTO
    // posterior (update todo-o-nada: precio + historial) es solo de
    // gerencia_general/director_proyectos/admin. SIN delete: el soft-delete
    // por `estado` es el único retiro (restricción 5.1 — un ítem con
    // trazabilidad a cotizaciones no se borra físicamente).
    match /catalogo_items/{itemId} {
      allow read: if accesoSIGP();
      allow create: if puedeGestionarProyectos();
      allow update: if puedeMantenerCatalogo();
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: proyectos — SIGP, Ejecución, F2.1.a
    // ────────────────────────────────────────────────────────────────
    // Read: acceso SIGP. Write: gestión de proyectos. El doc nace al aprobar
    // una cotización (id del proyecto = id de la cotización → 1:1 idempotente);
    // el consecutivo PRY-YYYY-NNN lo genera la Cloud Function generarConsecutivo.

    match /proyectos/{proyectoId} {
      // Bloque 3a (ajuste de confidencialidad): SST NO lee proyectos —
      // contienen valor de venta, márgenes y preliquidación. Su cola vive
      // en la proyección delgada `verificaciones_sst` (más abajo).
      // §16 (07-ago): comercial FUERA — read por lista sin operacion_comercial;
      // create solo escotilla de gestores (el creador primario es la CF).
      allow read: if puedeVerProyectos();
      allow create: if puedeCrearProyectos();
      // Bloque final: un proyecto CERRADO es inmutable — tampoco se borra.
      // §16: delete por la misma vía que create/update (sin comercial) — lo
      // atrapó la batería SB4: sin read no hay delete coherente.
      // Cierre anticipado (28-sep): `cancelado` es tan terminal como cerrado
      // — tampoco se borra ni se edita (la única excepción es conciliar sus
      // asignaciones: vía de gerencia, abajo).
      allow delete: if puedeCrearProyectos()
                    && resource.data.get('estado', '') != 'cerrado'
                    && resource.data.get('estado', '') != 'cancelado';

      // Bloque 3a/3b: liquidar al contratista exige el aval SST leído de la
      // PROYECCIÓN (gate NO esquivable). El get() solo se evalúa al intentar
      // 'liquidado_contratista'; si la proyección no existe, deniega.
      // Bloque final: cerrado = INMUTABLE (ni gestores ni gerencia editan un
      // proyecto cerrado) y a `cerrado` SOLO se llega desde
      // `liquidado_contratista`.
      // Respaldo de aprobación (23-jul): los roles de PROYECTOS no aprueban
      // la preliquidación (definir y aprobar en la misma área rompe la
      // segregación); admin y gerencia_general SÍ, como RESPALDO, y su
      // aprobación exige salvedad.
      // Liquidación anticipada (23-jul) — MÁQUINA EXPLÍCITA hacia
      // liquidado_contratista: normal desde pagado_cliente; ANTICIPADA solo
      // desde facturado con marca + justificación (acuerdo con Gerencia de
      // Proyectos); ningún otro origen. El gate SST al_dia es INNEGOCIABLE
      // en ambas vías. El CIERRE exige el pago del cliente registrado (no
      // se cierra con cuenta por cobrar abierta).
      // §16: la vía operativa también sin comercial (sin read no hay
      // update coherente — evita el write a ciegas por id).
      // Cierre anticipado (28-sep): cancelado inmutable; y A `cancelado` solo
      // desde estados PRE-facturado con el registro `cierre_anticipado` en el
      // mismo write (desde facturado+ reversar es territorio administrativo).
      allow update: if puedeCrearProyectos()
                    && resource.data.get('estado', '') != 'cerrado'
                    && resource.data.get('estado', '') != 'cancelado'
                    && (request.resource.data.get('estado', '') != 'cancelado'
                        || (resource.data.get('estado', '') in
                              ['creado', 'contratista_asignado', 'permisos_en_tramite',
                               'preliquidacion_definida', 'preliquidacion_aprobada', 'anticipo_girado',
                               'en_ejecucion', 'ejecutado', 'entregado_cliente', 'soporte_recibido',
                               'enviado_a_facturacion']
                            && request.resource.data.get('cierre_anticipado', null) != null))
                    && (!fijaAprobacionPreliq()
                        || (rolActual() in ['admin', 'gerencia_general']
                            && salvedadPreliq() != ''))
                    && (request.resource.data.get('estado', '') != 'cerrado'
                        || (resource.data.get('estado', '') == 'liquidado_contratista'
                            && request.resource.data.get('pago_cliente', null) != null))
                    && (request.resource.data.get('estado', '') != 'liquidado_contratista'
                        || resource.data.get('estado', '') == 'liquidado_contratista'
                        // A.4 (28-oct — "la garantía vive donde sale el dinero"): el
                        // padre deja su propio get POR PROYECTO. O es el PUENTE del
                        // lote (sin 'liquidacion' propia; el resumen declara todo
                        // liquidado/cancelado — cada asignación ya pasó SU gate por
                        // contratista en su propio update), o es la vía LEGACY
                        // por-proyecto y el gate se consulta al doc del contratista
                        // de SU asignación. Duplicar la verificación arriba crearía
                        // dos verdades sobre lo mismo.
                        || (((!request.resource.data.diff(resource.data).affectedKeys().hasAny(['liquidacion'])
                              && request.resource.data.get('resumen_asignaciones', {}).get('por_estado', {}).keys().hasOnly(['liquidada', 'cancelada']))
                             || get(/databases/$(database)/documents/verificaciones_sst/$(proyectoId + '__' + resource.data.get('asignacion', {}).get('contratista_id', '')))
                                  .data.get('sst_gate', {}).get('estado', '') == 'al_dia')
                            && (resource.data.get('estado', '') == 'pagado_cliente'
                                || (resource.data.get('estado', '') == 'facturado'
                                    && request.resource.data.get('liquidacion', {}).get('liquidacion_anticipada', false) == true
                                    && request.resource.data.get('liquidacion', {}).get('justificacion_anticipada', '') != ''))));

      // Respaldo de aprobación (23-jul): gestion_integral SOLO aprueba la
      // preliquidación (hasOnly acotado) y siempre con salvedad. La titular
      // sigue siendo gerencia_administrativa (regla de abajo, sin salvedad).
      allow update: if isAuthed()
                    && rolActual() == 'gestion_integral'
                    && resource.data.get('estado', '') != 'cerrado'
                    && resource.data.get('estado', '') != 'cancelado'
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['preliquidacion', 'estado', 'historial', 'fecha_actualizacion'])
                    && fijaAprobacionPreliq()
                    && salvedadPreliq() != ''
                    && request.resource.data.get('estado', '') in ['preliquidacion_aprobada', 'anticipo_girado'];

      // F2.1.c — SEGREGACIÓN DE FUNCIONES: gerencia_administrativa aprueba la
      // preliquidación y registra el anticipo girado (quien define ≠ quien
      // desembolsa). Administrativa B1+B2 (22-jul-2026): además REGISTRA la
      // factura ('facturacion') y el pago del cliente ('pago_cliente').
      // B3b (23-jul-2026): + 'liquidacion' (cierre con el contratista) y
      // 'compras_reembolsos' — el SIGP registra, no ejecuta dinero. Sigue sin
      // poder tocar snapshot, asignación, alcance ni el resto del proyecto
      // (patrón hasOnly, como contratistas.estado). No crea ni elimina.
      // P2-2 (SB4): + 'resumen_asignaciones' — aprobar/girar POR ASIGNACIÓN
      // escribe el sub-doc y recalcula el resumen del padre en el MISMO batch.
      // 08-oct: + 'facturas_anuladas' — anular y reemplazar, NUNCA editar:
      // la factura anulada queda congelada (número y CUFE intactos, nota
      // crédito obligatoria en el builder) y el estado revierte facturado →
      // enviado_a_facturacion para registrar la correcta como factura NUEVA.
      allow update: if isAuthed()
                    && rolActual() == 'gerencia_administrativa'
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['preliquidacion', 'facturacion', 'facturas_anuladas', 'pago_cliente', 'liquidacion', 'compras_reembolsos', 'cierre', 'estado', 'historial', 'fecha_actualizacion', 'resumen_asignaciones'])
                    // Bloque final: cerrado inmutable + solo desde liquidado
                    // CON el pago del cliente registrado (no se cierra con
                    // cuenta por cobrar abierta — anticipada, 23-jul)
                    && resource.data.get('estado', '') != 'cerrado'
                    // Cierre anticipado (28-sep): sobre un CANCELADO, gerencia
                    // solo re-sincroniza el resumen al liquidar asignaciones
                    // canceladas con incurrido (cancelada → liquidada) — nada
                    // más del padre se toca.
                    && (resource.data.get('estado', '') != 'cancelado'
                        || request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['resumen_asignaciones', 'fecha_actualizacion']))
                    && (request.resource.data.get('estado', '') != 'cerrado'
                        || (resource.data.get('estado', '') == 'liquidado_contratista'
                            && request.resource.data.get('pago_cliente', null) != null))
                    // Bloque 3a/3b + anticipada (23-jul): liquidar exige el
                    // aval SST SIEMPRE; origen solo pagado_cliente (normal) o
                    // facturado (anticipada: marca + justificación). Un doc
                    // YA liquidado se puede seguir editando (p. ej. registrar
                    // el pago posterior) sin re-evaluar la transición.
                    && (request.resource.data.get('estado', '') != 'liquidado_contratista'
                        || resource.data.get('estado', '') == 'liquidado_contratista'
                        // A.4 (28-oct): mismo reemplazo que en la vía de gestores —
                        // puente del lote con resumen coherente, o gate POR
                        // CONTRATISTA de la asignación del padre (vía legacy).
                        || (((!request.resource.data.diff(resource.data).affectedKeys().hasAny(['liquidacion'])
                              && request.resource.data.get('resumen_asignaciones', {}).get('por_estado', {}).keys().hasOnly(['liquidada', 'cancelada']))
                             || get(/databases/$(database)/documents/verificaciones_sst/$(proyectoId + '__' + resource.data.get('asignacion', {}).get('contratista_id', '')))
                                  .data.get('sst_gate', {}).get('estado', '') == 'al_dia')
                            && (resource.data.get('estado', '') == 'pagado_cliente'
                                || (resource.data.get('estado', '') == 'facturado'
                                    && request.resource.data.get('liquidacion', {}).get('liquidacion_anticipada', false) == true
                                    && request.resource.data.get('liquidacion', {}).get('justificacion_anticipada', '') != ''))));

      // ── P2-2: asignaciones múltiples de contratista (SB5 endurecido) ──
      // Subcolección {aid} — cada asignación con su contratista, átomos,
      // preliquidación y liquidación PROPIAS. La economía baja del padre a
      // la asignación; el padre conserva `asignacion` (espejo de identidad)
      // y el caché `resumen_asignaciones`.
      //
      // ⚠ RIESGO CONOCIDO ACEPTADO (Giovanny, 03-sep): `resumen_asignaciones`
      // del padre es un CACHÉ y las reglas NO pueden validarlo contra la
      // subcolección (Firestore no consulta colecciones desde reglas) —
      // alguien con acceso de escritura podría dejarlo mintiendo. MITIGACIÓN:
      // la ficha (detectarDesincronizacion) compara resumen ↔ subcolección y
      // MUESTRA la discrepancia con botón de reparación — el control es la
      // detección visible, no la prevención imposible.
      match /asignaciones/{asignacionId} {
        allow read: if puedeVerProyectos();

        // P2-4: COHERENCIA de la administración directa — el estado
        // 'estimada' SOLO existe en el tipo 'administracion_directa' (si un
        // write dejara 'estimada' en un contratista, abriría el gate de
        // ejecución sin anticipo — la vía nueva no ablanda la vieja).
        function estadoCoherenteAsig() {
          return request.resource.data.get('estado', '') != 'estimada'
              || request.resource.data.get('tipo', '') == 'administracion_directa';
        }

        // GATE SST en la transición hacia 'liquidada' (26-oct — cierre del
        // hallazgo del frente SGI/SST, el cuarto de la racha «control
        // declarado ≠ control verificado»: la rama de gerencia liquidaba sin
        // consultar el aval — el gate "no esquivable" solo vivía en la UI).
        // Mismo criterio que la regla del padre hacia liquidado_contratista:
        // `verificaciones_sst/{proyectoId}.sst_gate` en 'al_dia'. Tres
        // términos: lo que NO llega a 'liquidada' no pide gate; un doc que
        // YA está liquidada no re-evalúa la transición (se sigue editando —
        // p. ej. un reembolso posterior); y LLEGAR exige el aval 'al_dia'
        // del MISMO proyecto Y rol gerencia_administrativa o admin.
        // ESTRECHAMIENTO (26-oct, mandato: "una regla más ancha que la
        // interfaz es una capacidad que nadie sabe que existe"): liquidar es
        // de gerencia_administrativa (espejo de puedeLiquidarUI) + admin como
        // respaldo de infraestructura DECLARADO aquí; gestion_integral queda
        // fuera (escribe el gate — avalarse y pagarse rompería la
        // segregación) y gerencia_general también (ninguna pantalla se lo
        // ofrecía; aprobar preliquidación con salvedad sigue siendo su vía).
        // SIN exención por `tipo`: la ADMINISTRACIÓN DIRECTA la cierran los
        // GESTORES por su propia rama (sin gate — decisión 04-sep,
        // RATIFICADA 26-oct: no sale dinero a terceros); eximirla aquí
        // dejaría una etiqueta editable como único candado.
        // Sin proyección el get() falla y la regla CIERRA — la ausencia de
        // dato JAMÁS se interpreta como aval. Incluye `cancelada → liquidada`
        // en un proyecto CANCELADO (sin proyección): queda CERRADA y
        // NOMBRADA (26-oct, censo: 2 canceladas en prod, ambas con $0
        // girado) — cuando exista el primer cancelado con incurrido real se
        // construye su vía explícita con autorización y traza propias, no un
        // hueco por ausencia de proyección.
        // ⚠ LÍMITE CONOCIDO (26-oct, levantado por el frente SGI/SST): el
        // gate es POR PROYECTO y la proyección nombra UN contratista_id,
        // pero desde que el átomo bajó al ítem un proyecto puede tener
        // VARIOS contratistas — este gate puede estar evaluando al que no
        // cobra (censo 26-oct: 0 multi-contratista en el tramo, 2 en toda la
        // base aguas arriba). INCOMPLETO mientras la proyección sea por
        // proyecto; el rediseño (proyección por contratista) es bloque
        // propio co-diseñado con el frente SGI/SST.
        // RESIDUAL conocido: los nacimientos en `liquidada` por CREATE
        // (registro histórico de gerencia / migración 'legacy') son otra vía
        // y no cambian — mientras existan, el gate no es total.
        // 28-oct (Parte A del bloque proyección/saldo — CIERRA el límite
        // escrito del PR #193): el get apunta al doc POR CONTRATISTA
        // `{proyectoId}__{contratista_id}` — SST avala al CONTRATISTA en el
        // proyecto (sus N asignaciones), y con varios contratistas el gate
        // ya no puede estar evaluando al que no cobra. `contratista_id` se
        // lee del RESOURCE (el doc existente) y es INMUTABLE en el update
        // (guard A3 abajo): no es suplantable en el mismo write. Sin doc
        // (legacy sin migrar, directa, o contratista sin proyección) el get
        // FALLA → DENIEGA — la ausencia jamás se lee como aval.
        function avalSstParaLiquidar() {
          return request.resource.data.get('estado', '') != 'liquidada'
              || resource.data.get('estado', '') == 'liquidada'
              || (rolActual() in ['gerencia_administrativa', 'admin']
                  && get(/databases/$(database)/documents/verificaciones_sst/$(proyectoId + '__' + resource.data.get('contratista_id', '')))
                       .data.get('sst_gate', {}).get('estado', '') == 'al_dia');
        }

        // CREATE — tres nacimientos, cada uno con su guardia:
        // (a) REGISTRO HISTÓRICO retroactivo (condición Giovanny 03-sep):
        //     afirmar "se pagó por fuera del panel" es una DECLARACIÓN DE
        //     GERENCIA — mismo perfil que aprueba preliquidaciones, con el
        //     motivo obligatorio validado AQUÍ (no solo en la UI) y la
        //     coherencia de nacer `liquidada` y marcada. Un gestor NO puede
        //     (el desvío del control de aprobación se cierra en reglas).
        // (b) MIGRACIÓN lazy/masiva: el sub-doc de id FIJO 'legacy' con la
        //     marca — UN solo cupo por proyecto (el id lo garantiza); lo
        //     dispara el primer write económico (gestores o gerencia).
        // (c) NORMAL: gestores; nace 'asignada' SIN economía ni marcas —
        //     aprobación/giro/liquidación llegan después por sus vías.
        //     P2-4: la administración directa nace por ESTA vía (tipo
        //     permitido al nacer; si viene, con valor conocido).
        allow create: if
          estadoCoherenteAsig()
          && ((request.resource.data.keys().hasAny(['registro_historico'])
            && isAuthed()
            && rolActual() in ['gerencia_administrativa', 'admin', 'gerencia_general', 'gestion_integral']
            && request.resource.data.get('registro_historico', {}).get('motivo', '') != ''
            && request.resource.data.get('estado', '') == 'liquidada')
          || (asignacionId == 'legacy'
            && request.resource.data.get('legacy', false) == true
            && (puedeCrearProyectos()
                || (isAuthed() && rolActual() == 'gerencia_administrativa')))
          || (puedeCrearProyectos()
            && request.resource.data.get('estado', '') == 'asignada'
            && (!request.resource.data.keys().hasAny(['tipo'])
                || request.resource.data.get('tipo', '') in ['contratista', 'administracion_directa'])
            && !request.resource.data.keys().hasAny(
                 ['registro_historico', 'legacy', 'preliquidacion', 'liquidacion', 'cancelacion', 'cierre_directa'])));

        // UPDATE — dos vías POR CAMPO (espejo del padre):
        // GESTORES definen/corrigen/ajustan/cancelan/resuelven señal — JAMÁS
        // fijan aprobación (retirarla en la reversión sí), jamás CREAN un
        // anticipo (conservar el existente en una corrección sí), jamás
        // tocan las marcas ni llevan a 'liquidada' (liquidar es de gerencia).
        // P2-4: EXCEPCIONES acotadas por tipo —
        //  · gestores SÍ cierran una ADMINISTRACIÓN DIRECTA (→ liquidada con
        //    cierre_directa): no sale dinero a terceros, el control es la
        //    señal de implausibilidad + la traza (decisión Giovanny 04-sep);
        //    el candado del contratista queda intacto.
        //  · `tipo` es INMUTABLE, con UNA excepción (caso Microlink): FIJARLO
        //    donde no había — solo a 'administracion_directa', solo en
        //    'asignada' y SIN economía cargada (el dato estaba incompleto,
        //    no equivocado).
        //  · `cierre_directa` solo se toca en el tipo directa.
        allow update: if
          estadoCoherenteAsig()
          // [A3 — 28-oct, BLOQUEA de la revisión del frente] contratista_id
          // INMUTABLE desde la creación, en TODAS las vías: mover una
          // asignación viva al contratista que está al día y liquidar con el
          // aval equivocado es exactamente el bypass que el gate por
          // contratista existe para impedir.
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['contratista_id'])
          && ((puedeCrearProyectos()
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['registro_historico', 'legacy'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tipo'])
                || (resource.data.get('tipo', null) == null
                    && resource.data.get('estado', '') == 'asignada'
                    && !resource.data.keys().hasAny(['preliquidacion', 'liquidacion', 'cierre_directa'])
                    && request.resource.data.get('tipo', '') == 'administracion_directa'))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['cierre_directa'])
                || resource.data.get('tipo', '') == 'administracion_directa')
            && !fijaAprobacionPreliq()
            // 28-sep (lo atrapó la batería del cierre anticipado): el guard
            // viejo impedía CREAR un anticipo pero no RETIRARLO — un gestor
            // podía borrar el giro registrado sin traza (y vaciar el
            // incurrido del cierre por la puerta de atrás). Ahora la
            // PRESENCIA del anticipo se conserva en ambas direcciones:
            // crear y anular son de gerencia (patchCorregirAnticipo).
            && (('anticipo' in resource.data.get('preliquidacion', {}).keys())
                == ('anticipo' in request.resource.data.get('preliquidacion', {}).keys()))
            // 28-oct (anticipos múltiples): el MISMO principio sobre la LISTA
            // `giros` — un gestor no la toca en NINGUNA dirección (girar,
            // corregir y anular son de gerencia; los rebuilds legítimos del
            // mapa la conservan por spread). Igualdad exacta: presencia Y
            // contenido — más fuerte que el guard de presencia del campo
            // legacy, porque la lista además no debe ENCOGER ni mutar.
            && (resource.data.get('preliquidacion', {}).get('giros', [])
                == request.resource.data.get('preliquidacion', {}).get('giros', []))
            && (request.resource.data.get('estado', '') != 'liquidada'
                || resource.data.get('tipo', '') == 'administracion_directa'))
          ||
          // GERENCIA (+ respaldo): aprueba/gira/liquida, acotada por-campo;
          // fijar aprobación exige la titular o salvedad escrita (PR #45);
          // LLEGAR a 'liquidada' exige el aval SST del proyecto (26-oct).
          (isAuthed()
            && rolActual() in ['gerencia_administrativa', 'admin', 'gerencia_general', 'gestion_integral']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado', 'preliquidacion', 'liquidacion', 'compras_reembolsos', 'historial', 'fecha_actualizacion'])
            && avalSstParaLiquidar()
            // C2 (28-oct, anticipos múltiples): GIRAR, CORREGIR y ANULAR
            // anticipos es SOLO de gerencia_administrativa + admin — quien
            // avala no paga: gestion_integral (escribe el gate SST y aprueba
            // preliquidaciones con salvedad) y gerencia_general quedan fuera
            // de los giros; aprobar una preliquidación no los cambia, así que
            // sus vías legítimas pasan por la rama de igualdad.
            && ((resource.data.get('preliquidacion', {}).get('giros', [])
                  == request.resource.data.get('preliquidacion', {}).get('giros', [])
                 && resource.data.get('preliquidacion', {}).get('anticipo', {})
                  == request.resource.data.get('preliquidacion', {}).get('anticipo', {}))
                || rolActual() in ['gerencia_administrativa', 'admin'])
            && (!fijaAprobacionPreliq()
                || rolActual() == 'gerencia_administrativa'
                || salvedadPreliq() != '')));
        // sin delete (cancelación = soft, restricción 5.1)
      }

      // ── Compras C3: compras menores del proyecto (sin OC) ──────────
      // Subcolección con reglas PROPIAS (no hereda del padre). Las registra
      // gerencia_administrativa/admin; el agregado de la CF las suma igual
      // que las OCs compradas. Sin delete (corrección por update — 5.1).
      match /compras_menores/{compraId} {
        allow read: if puedeVerOC();
        allow create, update: if gestionaCompras()
                              && request.resource.data.get('valor', 0) > 0;
      }
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: verificaciones_sst — Gate SST (Administrativa · Bloque 3a)
    // ────────────────────────────────────────────────────────────────
    // Proyección DELGADA del proyecto para el área SST: identidad + estado,
    // SIN datos financieros (SST no tiene acceso a `proyectos`). La escribe
    // la Cloud Function sincronizarVerificacionSst (Admin SDK — bypassa
    // reglas); el gate `sst_gate` lo posee SST. Gerencia/alta dirección la
    // leen para el chip del gate en su bandeja.

    // ── Aval SST: CONTENIDO de `sst_gate` — rama app / rama físico ───────
    // El hasOnly de abajo limita QUÉ campos del doc se tocan, no QUÉ se escribe
    // dentro de `sst_gate`: hasta ahora cualquiera de los 3 roles podía
    // escribir lo que quisiera ahí (incl. atribuir el aval a otra persona).
    // Dos ramas, mutuamente excluyentes:
    //  · APP (flujo de siempre — sst/residente_sst/gestion_integral): origen
    //    ausente o 'app', SIN el bloque `fisico`, claves conocidas, estado
    //    válido, `verificado_por` = quien escribe (la atribución no se
    //    falsifica: "Gestión Integral marcó" tiene que ser evidencia) y la
    //    novedad con observación. Cierra el colado de un "físico" sin
    //    evidencia por la rama que no la exige.
    //  · FÍSICO (formatos en papel — el cliente los exige y no hay formularios
    //    en la app; NO se escanean, pueden ser 100+ hojas): SOLO
    //    gestion_integral y con el REGISTRO DE CUSTODIA completo en la regla,
    //    no solo en la UI: responsable del archivo, ubicación, fecha de los
    //    formatos (no futura, ≤ 2 años), formatos que cubre (lista no vacía;
    //    'otro' exige nombrarlo), motivo, la DECLARACIÓN expresa (== true:
    //    originales archivados y disponibles para auditoría), y
    //    registrado_por/fecha del servidor (no falsificables). Más la copia
    //    COMPLETA del registro en `historial` (append de UNA entrada, lo
    //    anterior intacto — traza que sobrevive si otro avalista sobrescribe
    //    el gate después).
    //    La declaración es INMUTABLE: no se edita en sitio. Una corrección es
    //    un aval físico NUEVO — `fecha_registro == request.time` obliga a una
    //    fecha nueva y la copia obliga a una entrada nueva del historial (que
    //    es append-only: la declaración anterior permanece). La ubicación pide
    //    mínimo 10 caracteres para desalentar lo genérico (guía + longitud: la
    //    regla no puede exigir que sea "específica").
    // Residual conocido y aceptado: la regla garantiza que el registro de
    // custodia y la declaración EXISTAN y estén firmados por GI — no puede
    // comprobar que el archivo físico exista; esa responsabilidad es de quien
    // declara (y queda auditable: quién, cuándo, dónde).
    function textoValido(t, minimo) {
      return t is string && t.trim().size() >= minimo && t.size() <= 2000;
    }

    function avalAppValido(g) {
      let n = resource.data.get('historial', []).size();
      return g.keys().hasOnly(['estado', 'verificado_por', 'fecha', 'observacion', 'origen'])
          && g.get('origen', 'app') == 'app'
          && g.get('estado', '') in ['al_dia', 'con_novedad', 'pendiente']
          && g.get('verificado_por', '') == request.auth.uid
          && g.get('fecha', null) is timestamp
          && g.fecha > request.time - duration.value(1, 'd')
          && g.fecha < request.time + duration.value(1, 'd')
          && (g.get('estado', '') != 'con_novedad' || textoValido(g.get('observacion', ''), 1))
          // el cambio del gate deja TRAZA: una entrada nueva cuyo `a` es el
          // estado que quedó (la UI ya la escribe; así la cadena de quién
          // habilitó el pago no se pierde cuando otra persona sobrescribe).
          && request.resource.data.get('historial', []).size() == n + 1
          && request.resource.data.historial[n].get('a', '') == g.get('estado', '');
    }

    function fisicoCompleto(f) {
      return f.keys().hasAll(['responsable_archivo', 'ubicacion', 'fecha_formatos',
                              'tipos_formato', 'motivo', 'declaracion',
                              'declaracion_version', 'declaracion_email',
                              'registrado_por', 'fecha_registro'])
          && f.keys().hasOnly(['responsable_archivo', 'ubicacion', 'fecha_formatos',
                               'tipos_formato', 'formato_otro', 'motivo', 'declaracion',
                               'declaracion_version', 'declaracion_email',
                               'registrado_por', 'fecha_registro'])
          && textoValido(f.responsable_archivo, 3)
          && textoValido(f.ubicacion, 10)
          && f.fecha_formatos is timestamp && f.fecha_formatos <= request.time
          && f.fecha_formatos > request.time - duration.value(730, 'd')
          && f.tipos_formato is list && f.tipos_formato.size() > 0 && f.tipos_formato.size() <= 20
          && !('' in f.tipos_formato)
          && f.tipos_formato.toSet().size() == f.tipos_formato.size()
          && f.tipos_formato.join('|').size() <= 1000
          && (('otro' in f.tipos_formato) ? textoValido(f.get('formato_otro', ''), 3) : !('formato_otro' in f))
          && textoValido(f.motivo, 10)
          && f.declaracion is bool && f.declaracion == true
          // el texto aceptado va LIGADO a su versión (cambiar una palabra =
          // versión nueva) y quien declara queda identificado por el correo
          // AUTÉNTICO de su sesión, no tecleado: sobrevive aunque cambie el uid.
          && f.declaracion_version in ['SST-FIS-v1']
          && f.declaracion_email is string && f.declaracion_email.size() >= 3
          && f.declaracion_email == request.auth.token.email
          && f.registrado_por == request.auth.uid
          && f.fecha_registro == request.time;
    }

    // La copia en el historial: el array nuevo = el anterior + UNA entrada al
    // final, y esa entrada es la de ESTE aval — al_dia, por esta usuaria, desde
    // el estado que tenía el gate, con la evidencia COMPLETA idéntica a la del
    // gate (la única diferencia permitida es `fecha_registro`: un
    // serverTimestamp no puede ir dentro de un array).
    function historialConCopiaFisica(g) {
      let nuevo = request.resource.data.get('historial', []);
      let previo = resource.data.get('historial', []);
      return nuevo.size() == previo.size() + 1
          && (previo.size() == 0 || nuevo[0:previo.size()] == previo)
          && nuevo[previo.size()].get('a', '') == 'al_dia'
          && nuevo[previo.size()].get('por', '') == request.auth.uid
          && nuevo[previo.size()].get('de', '') == resource.data.get('sst_gate', {}).get('estado', 'pendiente')
          && nuevo[previo.size()].get('fisico', {}).get('fecha_registro', null) is timestamp
          && nuevo[previo.size()].get('fisico', {}).get('fecha_registro', null) == nuevo[previo.size()].get('fecha', null)
          && nuevo[previo.size()].get('fisico', {}).diff(g.fisico).affectedKeys().hasOnly(['fecha_registro']);
    }

    function avalFisicoValido(g) {
      return rolActual() == 'gestion_integral'
          && g.keys().hasOnly(['estado', 'verificado_por', 'fecha', 'origen', 'fisico'])
          && g.get('origen', '') == 'fisico'
          && g.get('estado', '') == 'al_dia'
          && g.get('verificado_por', '') == request.auth.uid
          && g.get('fecha', null) == request.time
          && g.get('fisico', null) is map
          && fisicoCompleto(g.fisico)
          && historialConCopiaFisica(g);
    }

    function entradaHistorialValida(e) {
      return e is map
          && e.keys().hasOnly(['de', 'a', 'por', 'fecha', 'motivo', 'fisico'])
          && e.get('por', '') == request.auth.uid
          && e.get('a', '') in ['al_dia', 'con_novedad', 'pendiente']
          && e.get('de', '') in ['al_dia', 'con_novedad', 'pendiente']
          && e.get('fecha', null) is timestamp
          && e.fecha > request.time - duration.value(1, 'd')
          && e.fecha < request.time + duration.value(1, 'd')
          && e.get('motivo', '') is string && e.get('motivo', '').size() <= 2500
          // la traza SOLO crece junto con un cambio del gate y cuenta lo que
          // quedó: no se agregan entradas sueltas (ni fechadas a gusto) que
          // cuenten una historia que el gate no tiene.
          && request.resource.data.diff(resource.data).affectedKeys().hasAny(['sst_gate'])
          && e.get('a', '') == request.resource.data.get('sst_gate', {}).get('estado', 'pendiente')
          // un bloque `fisico` en la traza solo entra junto con un gate FÍSICO.
          && (!('fisico' in e)
              || request.resource.data.get('sst_gate', {}).get('origen', '') == 'fisico');
    }

    // `historial` es traza append-only: ningún write de estos roles lo
    // reemplaza, lo recorta ni lo vacía — ni siquiera uno que no toque
    // `sst_gate` (que se saltaría la validación del gate). O queda igual, o
    // se agrega UNA entrada al final, atribuida a quien escribe.
    function historialSoloAgrega() {
      let nuevo = request.resource.data.get('historial', []);
      let previo = resource.data.get('historial', []);
      return nuevo is list
          && nuevo.size() <= 300
          && (nuevo == previo
              || (nuevo.size() == previo.size() + 1
                  && (previo.size() == 0 || nuevo[0:previo.size()] == previo)
                  && entradaHistorialValida(nuevo[previo.size()])));
    }

    // Solo se valida el gate cuando `sst_gate` CAMBIA. Borrarlo sigue permitido
    // (falla cerrado para el pago: la liquidación lo lee) PERO deja traza de quién
    // lo hizo: una entrada nueva (a == 'pendiente'), como cualquier cambio del gate.
    function contenidoGateValido() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sst_gate'])
          || (!('sst_gate' in request.resource.data)
              && request.resource.data.get('historial', []).size() == resource.data.get('historial', []).size() + 1)
          || avalAppValido(request.resource.data.sst_gate)
          || avalFisicoValido(request.resource.data.sst_gate);
    }

    match /verificaciones_sst/{proyectoId} {
      // 07-sep (decisión Giovanny): gestion_integral ENTRA al módulo — la
      // Caracterización asigna la habilitación de contratistas al SGI y el
      // módulo contradecía el procedimiento documentado (el 3a se construyó
      // como cola del rol sst; a GI nunca se la contempló — ni en lectura).
      // "Gestión Integral marcó la verificación" es evidencia; "admin marcó"
      // no lo es → admin SIGUE en solo lectura (decisión 3a intacta).
      allow read: if isAuthed() && rolActual() in [
        'sst', 'residente_sst', 'gestion_integral', 'admin',
        'gerencia_administrativa', 'gerencia_general'
      ];
      // sst/residente_sst/gestion_integral marcan el gate — su ÚNICO campo
      // de escritura (patrón hasOnly, como contratistas.estado). Nadie más
      // escribe el gate; create/delete solo la Cloud Function.
      allow update: if isAuthed()
                    && rolActual() in ['sst', 'residente_sst', 'gestion_integral']
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['sst_gate', 'historial', 'fecha_actualizacion'])
                    && historialSoloAgrega()
                    && contenidoGateValido();
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: indicadores — Panel SIGP (ISO 9.1)
    // ────────────────────────────────────────────────────────────────
    // Registro MANUAL de indicadores de proceso cruzado (hoy: ind. 5
    // ambiental/SST, doc `sst_YYYY-MM`) mientras no exista integración
    // automática. Read: acceso SIGP.
    // Write (21-sep, decisión Giovanny): helper propio — la vía heredada
    // de gestión de proyectos MÁS gestion_integral: la Caracterización
    // pone "indicadores" bajo el SGI y su dueña de proceso no podía
    // registrar el ind. 5, el que más le pertenece (barrido
    // Caracterización-vs-permisos, hallazgo 2).

    function registraIndicadores() {
      return puedeGestionarProyectos()
          || (isAuthed() && rolActual() == 'gestion_integral');
    }

    match /indicadores/{indicadorId} {
      allow read: if accesoSIGP();
      allow create, update: if registraIndicadores();
    }

    // ── Indicadores SG-SST (F1, 22-sep) — plan SST-PLA-EI-24. NO relacionado con
    // `indicadores` (arriba): ese es el ind. 5 mensual del tablero SIGP. Lectura
    // para el panel + gerencia; escritura solo sst/admin/gestion_integral — el
    // rol tecnico (app móvil) no entra. Espejo de ROLES_VE_INDICADORES_SST /
    // ROLES_GESTIONA_INDICADORES_SST en permisos.ts.
    function veIndicadoresSst() {
      return isAuthed() && rolActual() in [
        'admin', 'sst', 'gerencia_general', 'residente_sst', 'gestion_integral'
      ];
    }
    function gestionaIndicadoresSst() {
      return isAuthed() && rolActual() in ['sst', 'admin', 'gestion_integral'];
    }

    match /indicadores_sst/{indicadorId} {
      allow read: if veIndicadoresSst();
      allow create, update: if gestionaIndicadoresSst();
      allow delete: if false;
    }

    match /indicador_mediciones/{medicionId} {
      allow read: if veIndicadoresSst();
      allow create, update: if gestionaIndicadoresSst()
        && request.resource.data.registrado_por == request.auth.uid;
      allow delete: if false;
    }

    // Indicadores SG-SST F2: datos fuente (bitácoras/checklist) de los indicadores
    // con patron. registrado_por e indicador_id inmutables en update; delete solo
    // admin (traza de auditoría). Los toggles de checklist envían registrado_por
    // SOLO al crear (ver useIndicadorRegistros.marcarCriterioChecklist).
    match /indicador_registros/{registroId} {
      allow read: if veIndicadoresSst();
      allow create: if gestionaIndicadoresSst()
        && request.resource.data.registrado_por == request.auth.uid;
      allow update: if gestionaIndicadoresSst()
        && request.resource.data.registrado_por == resource.data.registrado_por
        && request.resource.data.indicador_id == resource.data.indicador_id;
      allow delete: if isAuthed() && rolActual() == 'admin';
    }

    // ── Configuración de indicadores (Opción B, 07-ago): metas editables ──
    // Lectura: quien ve el tablero. Escritura: SOLO gerencia_general/admin.
    // Sin delete. Docs: configuracion/indicadores { meta_margen_pct } y
    // configuracion/horario { ips_oficina[], hora_fin_jornada } (#3 SB2 —
    // cubierto por esta MISMA regla genérica, sin cambio).
    match /configuracion/{docId} {
      allow read: if accesoSIGP();
      allow create, update: if isAuthed() && rolActual() in ['gerencia_general', 'admin'];
    }

    // ── Metas ISO del tablero (21-sep, decisión Giovanny) ──
    // `configuracion/indicadores.metas_iso`: las metas de los 5 indicadores
    // de la Caracterización las fija el SGI. gestion_integral entra con vía
    // POR-CAMPO que EXCLUYE `meta_margen_pct` — la meta del margen operativo
    // sigue siendo de gerencia_general (decisión deliberada del PR #69, que
    // conserva su vía por el match genérico de arriba). Los matches se UNEN:
    // GG+admin todo el doc (genérico) · GI solo metas_iso (este bloque).
    match /configuracion/indicadores {
      allow create: if isAuthed() && rolActual() == 'gestion_integral'
                    && request.resource.data.keys()
                        .hasOnly(['metas_iso', 'actualizado_por', 'fecha_actualizacion']);
      allow update: if isAuthed() && rolActual() == 'gestion_integral'
                    && request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['metas_iso', 'actualizado_por', 'fecha_actualizacion']);
    }

    // #3 SB3 (ratificado 07-ago): el doc `horario` lo lee CUALQUIER autenticado —
    // el pop-up de fin de jornada aplica a TODOS los roles del panel (incl.
    // sst/residente_sst, fuera de accesoSIGP). Solo IPs de oficina + hora de
    // jornada (nada económico); `indicadores` conserva su regla de arriba.
    // La escritura NO se amplía (la cubre el match genérico: GG+admin).
    match /configuracion/horario {
      allow read: if isAuthed();
    }

    // Horario POR PERSONA (13-oct): hora de CIERRE individual, fallback a la
    // general de `configuracion/horario`. La administra gerencia_administrativa
    // (+admin) — gestionaHorario(), el mismo dueño de ausentismos — y la LEE
    // cualquier autenticado del panel (cada cliente necesita SU hora para
    // ejecutar su propio cierre; una hora de salida no es dato sensible —
    // mismo razonamiento ratificado del match `configuracion/horario`).
    // El doc guarda SOLO horas de cierre (líneas duras en types/sigp/horario.ts:
    // sin variación por día, sin control de puntualidad — ambos = rediseño).
    // Sin delete. El match genérico de configuracion (GG+admin) se UNE.
    match /configuracion/horarios_personales {
      allow read: if isAuthed();
      allow create, update: if gestionaHorario();
    }

    // Licitaciones 1.2 — REGISTRO DEL CRITERIO del semáforo.
    // Doc: configuracion/semaforo_versiones { versiones: {...}, version_actual }.
    // LECTURA: la da el match genérico de arriba (`accesoSIGP()`), que ya
    // incluye a operacion_comercial — no se re-declara aquí (patrón del match
    // `configuracion/horario`: cada bloque declara solo lo que AMPLÍA).
    // ESCRITURA: este match la extiende de [GG, admin] a
    // escribeCriterioSemaforo() = [GG, director_proyectos, admin].
    // En Firestore los matches se UNEN, así que el resultado es exactamente
    // esa lista — y `operacion_comercial` sigue fuera por ambas vías.
    // Sin delete: el historial de versiones del criterio no se borra.
    match /configuracion/semaforo_versiones {
      allow create, update: if escribeCriterioSemaforo();
    }

    // ── Plantilla de requisitos del pliego típico (A.2a) ──
    // LECTURA: la da el match genérico de arriba (accesoSIGP) — la plantilla
    // es la lista de lo que un pliego suele pedir, no tiene nada reservado.
    // ESCRITURA: este match la extiende de [GG, admin] a
    // editaPlantillaRequisitos() = [GG, director_proyectos, admin].
    // En Firestore los matches se UNEN, así que el resultado es exactamente
    // esa lista — y `operacion_comercial` sigue fuera por ambas vías.
    // Sin delete: el historial de versiones de la plantilla no se borra.
    match /configuracion/plantilla_requisitos {
      allow create, update: if editaPlantillaRequisitos();
    }

    // ────────────────────────────────────────────────────────────────
    // MÓDULO HORARIO / ASISTENCIA (#3) — SB2 (07-ago-2026)
    // ────────────────────────────────────────────────────────────────
    // Eventos de reloj (ingreso/salida): los escribe SOLO la CF
    // registrarEventoHorario con Admin SDK — IP, dispositivo y timestamp
    // son server-side. Nadie "corrige el reloj" desde el panel: CERO
    // writes de cliente, explícito (patrón compras_proyecto).
    match /registros_horario/{registroId} {
      allow read: if veHorario();
      allow create, update, delete: if false;   // solo la CF (Admin SDK)
    }

    // Jornadas por PRESENCIA (rebuild 09-oct-2026): un doc por persona por
    // día local de Bogotá (`{uid}_{YYYY-MM-DD}`), mantenido SOLO por la CF
    // latidoJornada (Admin SDK) — timestamp/IP/día son server-side y el
    // payload del cliente es {accion} a secas: el modelo no PUEDE guardar
    // páginas, clics ni tiempo por pantalla (línea dura de privacidad).
    // `registros_horario` (arriba) queda congelado como histórico. El cierre
    // automático es DERIVADO en lectura — no existe escritor para él.
    match /jornadas/{jornadaId} {
      allow read: if veHorario();
      allow create, update, delete: if false;   // solo la CF (Admin SDK)
    }

    // Ausentismos (incapacidad / permiso / justificación / vacaciones):
    // los gestiona gerencia_administrativa (+admin); las gerencias los
    // leen para reportes. Soporte OBLIGATORIO al crear (patrón rut_url
    // de proveedores). Sin delete: anulación SOFT (estado + motivo, 5.1).
    match /ausentismos/{ausentismoId} {
      allow read: if veHorario();
      // create/update ampliados a gestion_integral (13-oct): el ACTO de
      // registrar un AT/EL es separable del dato clínico por construcción
      // (el sub-doc privado es opcional y queda abajo con gestionaHorario()).
      allow create: if registraAusentismo()
                    && request.resource.data.get('soporte_url', '') != ''
                    && origenAtelValido();
      allow update: if registraAusentismo()
                    && (!request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['tipo', 'origen'])
                        || origenAtelValido());

      // Detalle médico (diagnóstico/observaciones) = dato de SALUD —
      // LÍNEA DURA (decisión Giovanny 07-ago): solo gerencia_administrativa
      // + admin; ni gerencia_general lo lee (patrón datos_bancarios).
      match /privado/{docId} {
        allow read, create, update: if gestionaHorario();
      }
    }

    // ── Maestro de empleados directos (RRHH) — dato sensible (nombre + cédula,
    // Ley 1581). NO es la nómina de contratistas (contratistas/{id}/privado/nomina,
    // otro frente). Lectura Y escritura solo para admin + gestion_integral +
    // gerencia_administrativa (espejo de ROLES_GESTIONA_EMPLEADOS en permisos.ts);
    // sst/tecnico/gerencia_general/roles SIGP quedan fuera hasta que el SIGP los
    // pida. La baja es SOFT (update: fecha_retiro + activo=false). El delete
    // físico queda solo para admin — decisión del dueño del módulo (p. ej. el
    // derecho de supresión de la Ley 1581); la UI nunca lo invoca.
    function gestionaEmpleados() {
      return isAuthed() && rolActual() in ['admin', 'gestion_integral', 'gerencia_administrativa'];
    }

    match /empleados_directos/{empleadoId} {
      allow read: if gestionaEmpleados();
      // El alta nace vigente y con su auditoría completa (sin fecha_carga un
      // update posterior fallaría al leer resource.data.fecha_carga).
      allow create: if gestionaEmpleados()
                    && request.resource.data.cargado_por == request.auth.uid
                    && request.resource.data.actualizado_por == request.auth.uid
                    && request.resource.data.fecha_carga is timestamp
                    && request.resource.data.activo == true
                    && request.resource.data.fecha_retiro == null;
      // cargado_por y fecha_carga inmutables; el último editor queda firmado.
      allow update: if gestionaEmpleados()
                    && request.resource.data.cargado_por == resource.data.cargado_por
                    && request.resource.data.fecha_carga == resource.data.fecha_carga
                    && request.resource.data.actualizado_por == request.auth.uid;
      allow delete: if isAuthed() && rolActual() == 'admin';
    }

    // Módulo Tareas (14-ago): tareas con asignación y "balón en cancha".
    // Calco de ordenes_compra con TRES vías de update por `||`:
    //   asignador (editar/reasignar/anular — jamás cierra la tarea de otro)
    //   · asignado (por UID del doc — primera regla del SIGP autorizada por
    //     UID y no por rol; el balón lo pide por naturaleza)
    //   · receptor del balón (solo devolverlo).
    // `hecha`/`anulada` terminales sin reapertura (decisión SB1).
    // Sin delete — 'anulada' es el terminal suave (restricción 5.1).
    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: actividades — F1 de la operación in-house
    // ────────────────────────────────────────────────────────────────
    // Actividades de mantenimiento con dos hitos independientes
    // (aprobación / ejecución) y líneas de LPU por alcance. El RESIDENTE
    // OPERA (crea, edita, carga líneas, marca ambos hitos) pero SOLO
    // dentro de su cliente — el doble esResidenteDe del update impide
    // mover una actividad hacia o desde otro cliente. Sin segregación
    // interna entre hitos: la evidencia de la aprobación es la
    // referencia (aprobacion.referencia), no quién la teclea.
    // Sin delete: anulación soft con motivo (restricción 5.1).
    match /actividades/{actividadId} {
      allow read: if gestionaActividades() || gestionaCompras()
                  || esResidenteDe(resource.data.cliente_id);
      allow create: if gestionaActividades()
                    || esResidenteDe(request.resource.data.cliente_id);
      allow update: if gestionaActividades()
                    || (esResidenteDe(resource.data.cliente_id)
                        && esResidenteDe(request.resource.data.cliente_id));
      allow delete: if false;
    }

    // F1.2 — PROPUESTAS ECONÓMICAS de actividades: un doc por VERSIÓN
    // (patrón LPU vigente/historica; la re-emisión es un batch atómico que
    // historiza la anterior y re-apunta punteros). El RESIDENTE emite (negocia
    // con el gestor del cliente) acotado por su claim; el doble esResidenteDe
    // del update impide mover una propuesta entre clientes. Sin delete
    // (restricción 5.1) — las históricas se conservan con su PDF y su hash.
    // DECISIÓN DE NEGOCIO (Giovanny, 18-ago-2026): operacion_comercial NO
    // lee ni emite — vía gestionaActividades(), el helper propio del módulo
    // (ver su comentario). El pendiente que vivió aquí queda CERRADO.
    match /propuestas_actividad/{propuestaId} {
      allow read: if gestionaActividades()
                  || esResidenteDe(resource.data.cliente_id);
      allow create: if gestionaActividades()
                    || esResidenteDe(request.resource.data.cliente_id);
      allow update: if gestionaActividades()
                    || (esResidenteDe(resource.data.cliente_id)
                        && esResidenteDe(request.resource.data.cliente_id));
      allow delete: if false;
    }

    match /tareas/{tareaId} {
      allow read: if esPersonalPanel();

      // Nace SIEMPRE pendiente, con creador real no suplantable (patrón OC).
      // Asignador → a cualquiera; el resto del panel → SOLO a sí mismo.
      allow create: if isAuthed()
                    && request.resource.data.get('creada_por', '') == request.auth.uid
                    && request.resource.data.get('estado', '') == 'pendiente'
                    && request.resource.data.get('activa', false) == true
                    && request.resource.data.get('titulo', '') != ''
                    && request.resource.data.get('asignada_a', '') != ''
                    && (puedeAsignarTareas()
                        || (esPersonalPanel()
                            && request.resource.data.get('asignada_a', '') == request.auth.uid));

      allow update: if (
                    // ── Vía ASIGNADOR (o dueño de su AUTO-tarea) ──
                    (puedeAsignarTareas()
                     || (resource.data.get('creada_por', '') == request.auth.uid
                         && resource.data.get('asignada_a', '') == request.auth.uid))
                    && resource.data.get('estado', '') != 'hecha'
                    && resource.data.get('estado', '') != 'anulada'
                    && request.resource.data.get('creada_por', '')
                         == resource.data.get('creada_por', '')
                    // el asignador NO "hace" la tarea de otro: estado igual,
                    // o anulada, o pendiente (reasignación resetea)
                    && (request.resource.data.get('estado', '')
                          == resource.data.get('estado', '')
                        || request.resource.data.get('estado', '') in ['anulada', 'pendiente'])
                    // invariante del balón también en esta vía (anular /
                    // reasignar lo limpian; editar sin tocarlo lo conserva)
                    && (request.resource.data.get('estado', '') != 'en_espera'
                        || request.resource.data.get('balon_en', {}).get('uid', '') != '')
                    && (request.resource.data.get('estado', '') == 'en_espera'
                        || request.resource.data.get('balon_en', null) == null)
                    ) || (
                    // ── Vía ASIGNADO (autorizada por UID del doc) ──
                    isAuthed()
                    && resource.data.get('asignada_a', '') == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['estado', 'comentario_cierre', 'evidencia_url',
                                  'balon_en', 'historial', 'fecha_actualizacion', 'activa'])
                    && resource.data.get('estado', '') in ['pendiente', 'en_curso', 'en_espera']
                    && request.resource.data.get('estado', '') in ['en_curso', 'en_espera', 'hecha']
                    // cerrar exige comentario (+ evidencia si la tarea la pide)
                    && (request.resource.data.get('estado', '') != 'hecha'
                        || (request.resource.data.get('comentario_cierre', '') != ''
                            && (resource.data.get('requiere_evidencia', false) == false
                                || request.resource.data.get('evidencia_url', '') != '')))
                    // invariante del balón: en_espera ⟺ balon_en con uid
                    && (request.resource.data.get('estado', '') != 'en_espera'
                        || request.resource.data.get('balon_en', {}).get('uid', '') != '')
                    && (request.resource.data.get('estado', '') == 'en_espera'
                        || request.resource.data.get('balon_en', null) == null)
                    ) || (
                    // ── Vía RECEPTOR del balón: SOLO devolverlo ──
                    isAuthed()
                    && resource.data.get('estado', '') == 'en_espera'
                    && resource.data.get('balon_en', {}).get('uid', '') == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['estado', 'balon_en', 'historial', 'fecha_actualizacion', 'activa'])
                    && request.resource.data.get('estado', '') == 'en_curso'
                    && request.resource.data.get('balon_en', null) == null
                    );
      // sin delete — 'anulada' es el terminal suave (restricción 5.1)
    }

    // ────────────────────────────────────────────────────────────────
    // MÓDULO LICITACIONES (1.2) — procesos de SECOP
    // ────────────────────────────────────────────────────────────────
    // El documento vive en `types/sigp/licitacion.ts`; la máquina de estados y
    // las 5 invariantes las imponen los patch builders puros. Aquí se fijan
    // SOLO los invariantes que un cliente no puede falsear: quién entra, quién
    // dice ser, con qué estado nace y qué no se muta nunca.
    match /licitaciones/{licitacionId} {
      allow read: if gestionaLicitaciones();

      // Nace SIEMPRE 'detectada' y activa, con creador real no suplantable
      // (patrón OC/tareas). `numero_proceso` es la identidad del proceso en
      // SECOP y `semaforo_version` el criterio con que se clasificó: sin
      // ninguno de los dos el documento no es auditable.
      // CONSECUTIVO DIFERIDO (1.2b): nace VACÍO y se quema al materializar
      // (contigüidad ISO — un proceso detectado y descartado no gasta número).
      allow create: if gestionaLicitaciones()
                    && request.resource.data.get('creado_por', '') == request.auth.uid
                    && request.resource.data.get('estado', '') == 'detectada'
                    && request.resource.data.get('activa', false) == true
                    && request.resource.data.get('consecutivo', '') == ''
                    && request.resource.data.get('numero_proceso', '') != ''
                    && request.resource.data.get('semaforo_version', '') != '';

      // El actor no se suplanta; el creador es inmutable.
      allow update: if gestionaLicitaciones()
                    && request.resource.data.get('actualizado_por', '') == request.auth.uid
                    && request.resource.data.get('creado_por', '')
                         == resource.data.get('creado_por', '')

                    // Invariante 7: el consecutivo es inmutable una vez
                    // asignado. Exactamente dos casos legales — que no cambie,
                    // o la asignación inicial desde '' con el formato de la
                    // serie. Reescribir, limpiar o meter basura: denegado.
                    && (
                         request.resource.data.get('consecutivo', '')
                           == resource.data.get('consecutivo', '')
                         || (resource.data.get('consecutivo', '') == ''
                             && request.resource.data.get('consecutivo', '')
                                  .matches('^LIC-[0-9]{4}-[0-9]{4,}$'))
                       )

                    // `migrado` es inmutable: un histórico no se convierte en
                    // numerado ni al revés (1.3).
                    && request.resource.data.get('migrado', false)
                         == resource.data.get('migrado', false)

                    // Invariante 6: no se entra a un estado de compromiso o de
                    // resultado sin número. Como `request.resource.data` es el
                    // documento RESULTANTE, esto obliga a que el consecutivo
                    // viaje EN EL MISMO update que la transición — nunca queda
                    // un instante en `en_preparacion` sin número.
                    // EXCEPCIÓN de los MIGRADOS (1.3): los ~350 históricos
                    // entran en estados de resultado SIN número porque la serie
                    // no existía. Sin esta salida, CUALQUIER update sobre un
                    // histórico quedaría denegado para siempre.
                    && (request.resource.data.get('migrado', false) == true
                        || !licExigeConsecutivo(request.resource.data.get('estado', ''))
                        || request.resource.data.get('consecutivo', '') != '');

      // Sin delete — soft-delete vía `activa` (restricción 5.1). Denegado
      // incluso para admin: un proceso de SECOP no se borra, se descarta.

      // ── ECONOMÍA (subcolección): oferta, márgenes, análisis del precio ──
      // Este match NO hereda del padre: en Firestore un `match` de un
      // documento no cubre sus subcolecciones salvo con `{x=**}`, que aquí
      // deliberadamente NO se usa. `operacion_comercial` tiene read del padre
      // y NINGÚN acceso a esta subcolección — el test que importa es
      // justamente ese (actor de mínimo privilegio: autenticado, con acceso
      // pleno a la licitación, y 403 acá).
      // `create, update` en vez de `write`: SIN delete (restricción 5.1, cero
      // borrado físico). El análisis económico de un proceso es evidencia de
      // cómo se decidió una oferta — se corrige con una versión nueva, no se
      // borra. Denegado incluso para admin.
      match /economia/{docId} {
        allow read, create, update: if veEconomiaLicitacion();
      }

      // ── REQUISITOS del pliego (subcolección, A.2a) ──
      // El checklist de habilitación. Como `economia`, este match NO hereda
      // del padre (un `match` de documento no cubre subcolecciones salvo con
      // `{x=**}`, que deliberadamente no se usa) — pero a diferencia de la
      // economía, acá SÍ entra todo el módulo: el checklist es el trabajo de
      // quien arma la propuesta.
      //
      // Lo que las reglas fijan es lo que un cliente NO puede falsear; la
      // máquina del requisito y sus cuatro invariantes las imponen los patch
      // builders puros de `types/sigp/requisito.ts`.
      match /requisitos/{reqId} {
        allow read: if gestionaLicitaciones();

        // NACE COMO PREGUNTA, NO COMO RESPUESTA: siempre `pendiente`, con
        // descripción (un requisito sin texto no es verificable por nadie) y
        // activo. `estado: 'pendiente'` en el create es la pata de reglas de
        // la invariante 1 — ni clonando una plantilla ni por un write a mano
        // entra un veredicto heredado.
        // `creado_por` real no suplantable: patrón del padre, de OC y de
        // tareas. No estaba en el pedido; se agrega porque dejar el autor
        // falsificable en una colección nueva, cuando todas sus hermanas lo
        // fijan, es abrir un hueco a sabiendas.
        allow create: if gestionaLicitaciones()
                      && request.resource.data.get('creado_por', '') == request.auth.uid
                      && request.resource.data.get('estado', '') == 'pendiente'
                      && request.resource.data.get('descripcion', '') != ''
                      && request.resource.data.get('activo', false) == true;

        // NADIE FIRMA UN VEREDICTO CON EL NOMBRE DE OTRO. Como
        // `request.resource.data` es el documento RESULTANTE: si el resultado
        // NO es `pendiente`, su `verificado_por` tiene que ser quien está
        // escribiendo.
        //
        // ⚠ CONSECUENCIA DELIBERADA, que no es obvia leyendo la frase: un
        // requisito ya verificado por Pedro NO lo puede tocar Karen sin
        // volver a firmarlo ella. No es un bloqueo — `patchMarcarRequisito`
        // re-firma con el actor en cada movimiento, así que el camino normal
        // funciona y queda honesto (si Karen lo edita, Karen es la nueva
        // verificadora). Y devolverlo a `pendiente` siempre está abierto:
        // ahí el resultado ES pendiente y la cláusula no aplica.
        //
        // `actualizado_por` real y `creado_por` inmutable: mismas razones que
        // en el padre; tampoco estaban en el pedido.
        allow update: if gestionaLicitaciones()
                      && request.resource.data.get('actualizado_por', '') == request.auth.uid
                      && request.resource.data.get('creado_por', '')
                           == resource.data.get('creado_por', '')
                      && (
                           request.resource.data.get('estado', '') == 'pendiente'
                           || request.resource.data.get('verificado_por', '')
                                == request.auth.uid
                         );

        // Sin delete — DENEGADO SIEMPRE, incluso para admin (restricción 5.1).
        // Los dos caminos, que no son el mismo: un requisito MAL CREADO se
        // marca `activo: false` (nunca debió estar ahí); uno que no
        // corresponde al pliego va a `no_aplica` (alguien lo miró y decidió,
        // y queda firmado por la invariante 2). Borrarlo perdería cuál de
        // las dos cosas pasó.
      }
    }

    // ────────────────────────────────────────────────────────────────
    // MÓDULO AC/AP · F1 — acciones_mejora (ISO 10.2: acciones
    // correctivas / preventivas / de mejora)
    // ────────────────────────────────────────────────────────────────
    // Matriz de acciones del SGI. Dueño: Gestión Integral (+ admin). Nadie
    // más la lee: los hallazgos y su análisis de causa son registro del SGI,
    // no del panel en general (mínimo privilegio, como la economía de
    // licitaciones). Espejo en el cliente: ROLES_GESTIONA_ACAP.
    //
    // CICLO: nace `borrador` (sin consecutivo); se edita mientras sea
    // borrador; se EMITE (borrador → abierta: F2a) asignando el consecutivo;
    // se ANULA (borrador|abierta → anulada) con motivo — `anulada` es
    // TERMINAL (cero escrituras). Sin delete para NADIE, admin incluido: la
    // baja es la anulación — evidencia de auditoría, cero borrado físico (5.1).
    //
    // EMITIR (F2a, OPCIÓN A — decisión de Giovanny): la regla valida la FORMA
    // del consecutivo (prefijo según el tipo, año en curso, número ≥ 1) y que
    // la causa raíz esté COMPLETA, pero NO puede comprobar que el número
    // provenga de la CF generarConsecutivo: el contador `consecutivos` es de
    // la CF y las reglas no lo cruzan. RESIDUAL: un gestor con un cliente
    // modificado podría escribir un número bien formado sin pasar por la CF
    // (saltándose la serie o repitiéndola). El uso normal es seguro (la UI
    // siempre lo pide a la CF). Cerrarlo = que la CF emita en una transacción.
    //
    // Historial APPEND-ONLY (patrón historialSoloAgrega de
    // verificaciones_sst): queda igual o crece en UNA entrada al final, con
    // el prefijo intacto, firmada por quien escribe, y su `a`/`de` dicen la
    // verdad (el estado que quedó / el que había) — la traza no cuenta una
    // historia que el doc no tiene.
    function gestionaAcAp() {
      return isAuthed() && rolActual() in ['gestion_integral', 'admin'];
    }

    // Forma del documento — LA MISMA en create y en la edición del borrador.
    // `numeral_norma`: ≤20 strings NO vacíos de ≤100 caracteres. Las reglas
    // no iteran listas: se une con '|' y una regex exige segmentos de 1..100.
    // Antes, la IDA Y VUELTA (join → split == la lista original) prueba que
    // todo elemento es string (join CONVIERTE números a texto: el 102 volvería
    // como '102' y la igualdad falla — lo atrapó la batería) y que ninguno
    // trae '|' (si no, un elemento podría partirse en "segmentos" y burlar el
    // tope de 100).
    function contenidoAccionValido(d) {
      return d.keys().hasOnly(['tipo', 'fecha_tratamiento', 'cliente_proceso',
                               'lider_proceso', 'numeral_norma', 'descripcion_nc',
                               'observaciones', 'fuente', 'origen_ref', 'causa_raiz',
                               'estado', 'consecutivo', 'anulacion', 'creado_por',
                               'creado_por_nombre', 'fecha_creacion',
                               'fecha_actualizacion', 'historial'])
          && d.keys().hasAll(['tipo', 'fecha_tratamiento', 'descripcion_nc', 'fuente',
                              'estado', 'creado_por', 'fecha_creacion', 'historial',
                              'causa_raiz'])
          && d.tipo in ['correctiva', 'preventiva', 'mejora']
          && d.fuente in ['operaciones', 'registro_sgi', 'reporte_servicios',
                          'quejas_reclamos', 'auditoria', 'satisfaccion_cliente',
                          'objetivos_sgi', 'mediciones', 'evaluacion_proveedores',
                          'analisis_datos', 'inspecciones', 'rechazo_sst']
          && d.estado in ['borrador', 'abierta', 'anulada']
          && d.fecha_tratamiento is timestamp
          && d.fecha_creacion is timestamp
          && d.descripcion_nc is string
          && d.descripcion_nc.trim().size() > 0
          && d.descripcion_nc.size() <= 4000
          && (!('cliente_proceso' in d) || (d.cliente_proceso is string && d.cliente_proceso.size() <= 300))
          && (!('lider_proceso' in d) || (d.lider_proceso is string && d.lider_proceso.size() <= 300))
          && (!('observaciones' in d) || (d.observaciones is string && d.observaciones.size() <= 4000))
          && (!('origen_ref' in d) || d.origen_ref == null
              || (d.origen_ref is string && d.origen_ref.size() <= 500))
          && (!('creado_por_nombre' in d) || (d.creado_por_nombre is string && d.creado_por_nombre.size() <= 300))
          && (!('fecha_actualizacion' in d) || d.fecha_actualizacion is timestamp)
          && (!('consecutivo' in d) || d.consecutivo == null || d.consecutivo is string)
          && (!('anulacion' in d) || d.anulacion is map)
          && d.creado_por is string
          && d.historial is list && d.historial.size() <= 300
          && (!('numeral_norma' in d)
              || (d.numeral_norma is list
                  && d.numeral_norma.size() <= 20
                  && (d.numeral_norma.size() == 0
                      || (d.numeral_norma.join('|').split('[|]') == d.numeral_norma
                          && d.numeral_norma.join('|').matches('^[^|]{1,100}([|][^|]{1,100})*$')))))
          && d.causa_raiz is map
          && d.causa_raiz.keys().hasOnly(['porque_1', 'porque_2', 'porque_3', 'porque_4', 'porque_5'])
          && (!('porque_1' in d.causa_raiz) || (d.causa_raiz.porque_1 is string && d.causa_raiz.porque_1.size() <= 2000))
          && (!('porque_2' in d.causa_raiz) || (d.causa_raiz.porque_2 is string && d.causa_raiz.porque_2.size() <= 2000))
          && (!('porque_3' in d.causa_raiz) || (d.causa_raiz.porque_3 is string && d.causa_raiz.porque_3.size() <= 2000))
          && (!('porque_4' in d.causa_raiz) || (d.causa_raiz.porque_4 is string && d.causa_raiz.porque_4.size() <= 2000))
          && (!('porque_5' in d.causa_raiz) || (d.causa_raiz.porque_5 is string && d.causa_raiz.porque_5.size() <= 2000));
    }

    // Una entrada de historial: firmada por quien escribe, fechada ~ahora
    // (±1 día, patrón avalAppValido — el cliente usa Timestamp.now()), y su
    // `a` (si viene) es el estado que QUEDA tras este write.
    function entradaAcApValida(e) {
      return e is map
          && e.keys().hasAll(['fecha', 'por'])
          && e.keys().hasOnly(['fecha', 'por', 'por_nombre', 'de', 'a', 'nota'])
          && e.por == request.auth.uid
          && e.fecha is timestamp
          && e.fecha > request.time - duration.value(1, 'd')
          && e.fecha < request.time + duration.value(1, 'd')
          && (!('por_nombre' in e) || (e.por_nombre is string && e.por_nombre.size() <= 300))
          && (!('a' in e) || e.a == request.resource.data.estado)
          && (!('nota' in e) || (e.nota is string && e.nota.size() <= 2500));
    }

    // Update: el historial queda IGUAL o crece en EXACTAMENTE una entrada al
    // final (prefijo intacto); su `de` (si viene) es el estado que HABÍA.
    function historialAcApValido() {
      let nuevo = request.resource.data.get('historial', []);
      let previo = resource.data.get('historial', []);
      return nuevo is list
          && nuevo.size() <= 300
          && (nuevo == previo
              || (nuevo.size() == previo.size() + 1
                  && (previo.size() == 0 || nuevo[0:previo.size()] == previo)
                  && entradaAcApValida(nuevo[previo.size()])
                  && (!('de' in nuevo[previo.size()])
                      || nuevo[previo.size()].de == resource.data.estado)));
    }

    // El bloque de anulación: quién (el que escribe, no suplantable), cuándo
    // (~ahora) y por qué (motivo no vacío).
    function anulacionAcApValida(a) {
      return a is map
          && a.keys().hasAll(['fecha', 'por', 'motivo'])
          && a.keys().hasOnly(['fecha', 'por', 'por_nombre', 'motivo'])
          && a.por == request.auth.uid
          && a.fecha is timestamp
          && a.fecha > request.time - duration.value(1, 'd')
          && a.fecha < request.time + duration.value(1, 'd')
          && (!('por_nombre' in a) || (a.por_nombre is string && a.por_nombre.size() <= 300))
          && a.motivo is string
          && a.motivo.trim().size() > 0
          && a.motivo.size() <= 2000;
    }

    // F2a — prefijo del consecutivo según el tipo de acción.
    function prefijoAcAp(tipo) {
      return tipo == 'correctiva' ? 'AC' : (tipo == 'preventiva' ? 'AP' : (tipo == 'mejora' ? 'MEJ' : '__tipo_invalido__'));
    }

    // F2a — FORMA del consecutivo: `PREFIJO-AAAA-NNN` (NNN ≥ 3 dígitos, > 0), con el
    // prefijo que corresponde al TIPO de la acción y el AÑO en curso (UTC: el
    // mismo año que usa la CF, que corre en UTC, y `request.time`). Una acción
    // correctiva no puede llevar un AP-…; un número de otro año no se acepta
    // (un write tardío que cruza el año se rechaza: la UI pide un número nuevo).
    function consecutivoAcApValido(c, tipo) {
      return c is string
          && c.size() <= 24
          && c.matches('^(AC|AP|MEJ)-[0-9]{4}-([0-9]{3}|[1-9][0-9]{3,})$')
          && c.split('-')[0] == prefijoAcAp(tipo)
          && int(c.split('-')[1]) == request.time.year()
          && int(c.split('-')[2]) >= 1;
    }

    // F2a — los 5 por qués diligenciados (no vacíos). En borrador son
    // progresivos; al EMITIR se exigen completos.
    function causaRaizCompleta(cr) {
      return cr is map
          && cr.get('porque_1', '') is string && cr.get('porque_1', '').trim().size() > 0
          && cr.get('porque_2', '') is string && cr.get('porque_2', '').trim().size() > 0
          && cr.get('porque_3', '') is string && cr.get('porque_3', '').trim().size() > 0
          && cr.get('porque_4', '') is string && cr.get('porque_4', '').trim().size() > 0
          && cr.get('porque_5', '') is string && cr.get('porque_5', '').trim().size() > 0;
    }

    match /acciones_mejora/{accionId} {
      allow read: if gestionaAcAp();

      // Nace BORRADOR, del creador real, SIN consecutivo (se asigna
      // server-side al emitir — F2) y SIN anulación, con UNA entrada de
      // historial del creador hacia 'borrador' (sin `de`: no hay estado previo).
      allow create: if gestionaAcAp()
                    && contenidoAccionValido(request.resource.data)
                    && request.resource.data.creado_por == request.auth.uid
                    && request.resource.data.estado == 'borrador'
                    && request.resource.data.get('consecutivo', null) == null
                    && !('anulacion' in request.resource.data)
                    && request.resource.data.fecha_creacion > request.time - duration.value(1, 'd')
                    && request.resource.data.fecha_creacion < request.time + duration.value(1, 'd')
                    && request.resource.data.historial.size() == 1
                    && 'a' in request.resource.data.historial[0]
                    && !('de' in request.resource.data.historial[0])
                    && entradaAcApValida(request.resource.data.historial[0]);

      // Tres vías, ninguna sobre una ANULADA (terminal). creado_por,
      // creado_por_nombre, fecha_creacion y consecutivo quedan inmutables
      // porque NINGUNA vía los admite en su diff().affectedKeys() (cambiarlos
      // o borrarlos los haría aparecer ahí) — salvo la de EMITIR, que fija el
      // consecutivo UNA vez (de null a su valor) y jamás lo vuelve a tocar.
      allow update: if gestionaAcAp()
                    && resource.data.estado != 'anulada'
                    && historialAcApValido()
                    && (
                      // ── EDICIÓN del borrador: solo campos descriptivos; el
                      // estado no cambia y no se introduce `anulacion`.
                      (resource.data.estado == 'borrador'
                       && request.resource.data.estado == 'borrador'
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['tipo', 'fecha_tratamiento', 'cliente_proceso',
                                    'lider_proceso', 'numeral_norma', 'descripcion_nc',
                                    'observaciones', 'fuente', 'origen_ref', 'causa_raiz',
                                    'historial', 'fecha_actualizacion'])
                       && contenidoAccionValido(request.resource.data))
                      ||
                      // ── ANULACIÓN (borrador|abierta → anulada): el write toca
                      // SOLO estado/anulacion/historial/fecha_actualizacion,
                      // con el bloque de anulación completo y UNA entrada nueva
                      // de historial hacia 'anulada'. El resto del doc no cambia
                      // (por eso no se re-valida su forma: no se toca nada más, y
                      // el consecutivo de la abierta queda tal cual).
                      (resource.data.estado in ['borrador', 'abierta']
                       && request.resource.data.estado == 'anulada'
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['estado', 'anulacion', 'historial', 'fecha_actualizacion'])
                       && anulacionAcApValida(request.resource.data.anulacion)
                       && (!('fecha_actualizacion' in request.resource.data)
                           || request.resource.data.fecha_actualizacion is timestamp)
                       && request.resource.data.historial.size()
                            == resource.data.get('historial', []).size() + 1
                       && 'a' in request.resource.data.historial[request.resource.data.historial.size() - 1])
                      ||
                      // ── EMITIR (borrador → abierta) — F2a: el write toca SOLO
                      // estado/consecutivo/historial/fecha_actualizacion; el
                      // consecutivo pasa de null a un valor de FORMA válida para
                      // el tipo y el año (ver consecutivoAcApValido: forma, no
                      // procedencia — opción A); la causa raíz debe estar
                      // COMPLETA; el resultado sigue siendo un documento válido
                      // (un abierta no trae campos nuevos); y la entrada de
                      // historial nueva dice borrador → abierta.
                      (resource.data.estado == 'borrador'
                       && request.resource.data.estado == 'abierta'
                       && resource.data.get('consecutivo', null) == null
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['estado', 'consecutivo', 'historial', 'fecha_actualizacion'])
                       && consecutivoAcApValido(request.resource.data.get('consecutivo', null),
                                                resource.data.tipo)
                       && causaRaizCompleta(resource.data.causa_raiz)
                       && contenidoAccionValido(request.resource.data)
                       && request.resource.data.historial.size()
                            == resource.data.get('historial', []).size() + 1
                       && 'a' in request.resource.data.historial[request.resource.data.historial.size() - 1]
                       && 'de' in request.resource.data.historial[request.resource.data.historial.size() - 1])
                    );

      // Sin delete para NADIE (admin incluido): la baja es la anulación.
      allow delete: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // ACTAS DE ENTREGA DE EPP (SST-FT-AEP-18) — catalogo_epp + actas_epp
    // ────────────────────────────────────────────────────────────────
    // El acta lleva la CÉDULA del colaborador (dato personal, Ley 1581) y su
    // firma: lectura y escritura SOLO para Gestión Integral y admin (espejo en
    // el cliente: ROLES_GESTIONA_EPP). El catálogo (elementos ofrecidos al
    // armar un acta) lo lee todo el personal del panel y lo edita el mismo par.
    //
    // CICLO del acta: nace `borrador` (editable) → `firmada` (INMUTABLE:
    // contenido, firma y hash congelados) → `anulada` (marca + motivo SIN tocar
    // el contenido firmado; la corrección es un acta nueva). Una borrador
    // también se anula. Sin delete para NADIE, admin incluido: la baja es la
    // anulación — evidencia (restricción 5.1).
    //
    // LÍMITES HONESTOS (documentados, no ocultos):
    //  · Las reglas no iteran listas: de `items` y `firmantes_empresa` solo se
    //    valida el tamaño; la forma de cada fila la valida el builder del cliente.
    //  · Es una firma electrónica SIMPLE: la regla no puede probar que el
    //    colaborador dibujó el PNG, solo que lo registró GI/admin y que, firmada,
    //    nadie la cambia (ni el contenido que respalda).
    function gestionaEpp() {
      return isAuthed() && rolActual() in ['gestion_integral', 'admin'];
    }

    function catalogoEppValido(d) {
      return d.keys().hasOnly(['nombre', 'especificacion', 'unidad', 'cantidad_default',
                               'activo', 'creado_por', 'fecha_creacion',
                               'actualizado_por', 'fecha_actualizacion'])
          && d.keys().hasAll(['nombre', 'especificacion', 'unidad', 'cantidad_default',
                              'activo', 'creado_por', 'fecha_creacion',
                              'actualizado_por', 'fecha_actualizacion'])
          && d.nombre is string && d.nombre.trim().size() > 0 && d.nombre.size() <= 120
          && d.especificacion is string && d.especificacion.size() <= 500
          && d.unidad is string && d.unidad.trim().size() > 0 && d.unidad.size() <= 40
          && d.cantidad_default is int && d.cantidad_default >= 1 && d.cantidad_default <= 99
          && d.activo is bool
          && d.creado_por is string
          && d.fecha_creacion is timestamp
          && d.actualizado_por is string
          && d.fecha_actualizacion is timestamp;
    }

    match /catalogo_epp/{itemId} {
      allow read: if esPersonalPanel();
      allow create: if gestionaEpp()
                    && catalogoEppValido(request.resource.data)
                    && request.resource.data.creado_por == request.auth.uid
                    && request.resource.data.actualizado_por == request.auth.uid;
      // creado_por y fecha_creacion inmutables; el último editor queda firmado.
      allow update: if gestionaEpp()
                    && catalogoEppValido(request.resource.data)
                    && request.resource.data.creado_por == resource.data.creado_por
                    && request.resource.data.fecha_creacion == resource.data.fecha_creacion
                    && request.resource.data.actualizado_por == request.auth.uid;
      // Baja SOFT (activo): sin delete para nadie.
      allow delete: if false;
    }

    function colaboradorEppValido(c) {
      return c is map
          && c.keys().hasOnly(['fuente', 'ref_id', 'nombre', 'cedula', 'cargo', 'contratista_nombre'])
          && c.keys().hasAll(['fuente', 'ref_id', 'nombre', 'cedula', 'cargo'])
          && c.fuente in ['directo', 'contratista']
          && c.ref_id is string && c.ref_id.size() > 0 && c.ref_id.size() <= 100
          && c.nombre is string && c.nombre.trim().size() > 0 && c.nombre.size() <= 200
          && c.cedula is string && c.cedula.trim().size() > 0 && c.cedula.size() <= 30
          && c.cargo is string && c.cargo.size() <= 200
          && (!('contratista_nombre' in c)
              || (c.contratista_nombre is string && c.contratista_nombre.size() <= 200));
    }

    // Forma del documento — LA MISMA en create, en la edición del borrador y en
    // la firma. Coherencia firma ⟷ estado: `firmado` es true SOLO si trae
    // firma, hash y fecha_firma (los tres o ninguno); un borrador jamás está
    // firmado; una firmada siempre lo está; `anulacion` ⟺ estado 'anulada'.
    function contenidoActaEppValido(d) {
      return d.keys().hasOnly(['colaborador', 'items', 'firmantes_empresa', 'fecha',
                               'clausulas_version', 'estado', 'firmado',
                               'firma_colaborador', 'firma_hash', 'fecha_firma', 'anulacion',
                               'entregado_por', 'entregado_por_nombre',
                               'creado_por', 'creado_por_nombre', 'fecha_creacion',
                               'fecha_actualizacion', 'historial'])
          && d.keys().hasAll(['colaborador', 'items', 'firmantes_empresa', 'fecha',
                              'clausulas_version', 'estado', 'firmado',
                              'entregado_por', 'creado_por', 'fecha_creacion', 'historial'])
          && colaboradorEppValido(d.colaborador)
          && d.items is list && d.items.size() >= 1 && d.items.size() <= 30
          && d.firmantes_empresa is list && d.firmantes_empresa.size() >= 1 && d.firmantes_empresa.size() <= 5
          && d.fecha is timestamp
          && d.fecha <= d.fecha_creacion + duration.value(1, 'd')
          && d.fecha >= d.fecha_creacion - duration.value(30, 'd')
          && d.clausulas_version is string && d.clausulas_version.size() > 0 && d.clausulas_version.size() <= 20
          && d.estado in ['borrador', 'firmada', 'anulada']
          && d.firmado is bool
          && d.entregado_por is string
          && d.creado_por is string
          && d.fecha_creacion is timestamp
          && d.historial is list && d.historial.size() <= 300
          && (!('entregado_por_nombre' in d) || (d.entregado_por_nombre is string && d.entregado_por_nombre.size() <= 300))
          && (!('creado_por_nombre' in d) || (d.creado_por_nombre is string && d.creado_por_nombre.size() <= 300))
          && (!('fecha_actualizacion' in d) || d.fecha_actualizacion is timestamp)
          && d.firmado == ('firma_colaborador' in d)
          && d.firmado == ('firma_hash' in d)
          && d.firmado == ('fecha_firma' in d)
          && (d.estado != 'borrador' || d.firmado == false)
          && (d.estado != 'firmada' || d.firmado == true)
          && (d.estado == 'anulada') == ('anulacion' in d)
          && (!d.firmado || firmaEppValida(d))
          && (!('anulacion' in d) || d.anulacion is map);
    }

    // La firma: PNG en data URL (con tope de tamaño), hash SHA-256 hex y fecha ~ahora.
    function firmaEppValida(d) {
      return d.firma_colaborador is string
          && d.firma_colaborador.size() > 40
          && d.firma_colaborador.size() <= 100000
          && d.firma_colaborador.matches('^data:image/png;base64,iVBORw0KGgo[A-Za-z0-9+/]*={0,2}$')
          && d.firma_colaborador.size() % 4 == 2
          && d.firma_hash is string
          && d.firma_hash.matches('^[0-9a-f]{64}$')
          && d.fecha_firma is timestamp
          && d.fecha_firma > request.time - duration.value(1, 'd')
          && d.fecha_firma < request.time + duration.value(1, 'd');
    }

    // Una entrada de historial: firmada por quien escribe, fechada ~ahora, y su
    // `a` (si viene) es el estado que QUEDA tras este write.
    function entradaActaEppValida(e) {
      return e is map
          && e.keys().hasAll(['fecha', 'por'])
          && e.keys().hasOnly(['fecha', 'por', 'por_nombre', 'de', 'a', 'nota'])
          && e.por == request.auth.uid
          && e.fecha is timestamp
          && e.fecha > request.time - duration.value(1, 'd')
          && e.fecha < request.time + duration.value(1, 'd')
          && (!('por_nombre' in e) || (e.por_nombre is string && e.por_nombre.size() <= 300))
          && (!('a' in e) || e.a == request.resource.data.estado)
          && (!('nota' in e) || (e.nota is string && e.nota.size() <= 2500));
    }

    // Update: el historial queda IGUAL o crece en EXACTAMENTE una entrada al
    // final (prefijo intacto); su `de` (si viene) es el estado que HABÍA.
    function historialActaEppValido() {
      let nuevo = request.resource.data.get('historial', []);
      let previo = resource.data.get('historial', []);
      return nuevo is list
          && nuevo.size() <= 300
          && (nuevo == previo
              || (nuevo.size() == previo.size() + 1
                  && (previo.size() == 0 || nuevo[0:previo.size()] == previo)
                  && entradaActaEppValida(nuevo[previo.size()])
                  && (!('de' in nuevo[previo.size()])
                      || nuevo[previo.size()].de == resource.data.estado)));
    }

    function anulacionActaEppValida(a) {
      return a is map
          && a.keys().hasAll(['fecha', 'por', 'motivo'])
          && a.keys().hasOnly(['fecha', 'por', 'por_nombre', 'motivo'])
          && a.por == request.auth.uid
          && a.fecha is timestamp
          && a.fecha > request.time - duration.value(1, 'd')
          && a.fecha < request.time + duration.value(1, 'd')
          && (!('por_nombre' in a) || (a.por_nombre is string && a.por_nombre.size() <= 300))
          && a.motivo is string
          && a.motivo.trim().size() > 0
          && a.motivo.size() <= 2000;
    }

    match /actas_epp/{actaId} {
      allow read: if gestionaEpp();

      // Nace BORRADOR, del creador real (que es quien entrega), SIN firma ni
      // anulación, con UNA entrada de historial hacia 'borrador'.
      allow create: if gestionaEpp()
                    && contenidoActaEppValido(request.resource.data)
                    && request.resource.data.creado_por == request.auth.uid
                    && request.resource.data.entregado_por == request.auth.uid
                    && request.resource.data.estado == 'borrador'
                    && request.resource.data.firmado == false
                    && request.resource.data.fecha_creacion > request.time - duration.value(1, 'd')
                    && request.resource.data.fecha_creacion < request.time + duration.value(1, 'd')
                    && request.resource.data.historial.size() == 1
                    && 'a' in request.resource.data.historial[0]
                    && !('de' in request.resource.data.historial[0])
                    && entradaActaEppValida(request.resource.data.historial[0]);

      // Tres vías, ninguna sobre una ANULADA (terminal). La FIRMADA solo admite
      // la anulación: el contenido firmado no tiene vía de edición. creado_por,
      // entregado_por y fecha_creacion quedan inmutables porque ninguna vía los
      // admite en su diff().affectedKeys().
      allow update: if gestionaEpp()
                    && resource.data.estado != 'anulada'
                    && historialActaEppValido()
                    && (
                      // ── EDICIÓN del borrador: solo contenido descriptivo.
                      (resource.data.estado == 'borrador'
                       && request.resource.data.estado == 'borrador'
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['colaborador', 'items', 'firmantes_empresa', 'fecha',
                                    'historial', 'fecha_actualizacion'])
                       && contenidoActaEppValido(request.resource.data)
                       && request.resource.data.historial.size() <= 290
                       && request.resource.data.historial.size()
                            == resource.data.get('historial', []).size() + 1)
                      ||
                      // ── FIRMAR (borrador → firmada): el write toca SOLO
                      // estado/firmado/firma/hash/fecha_firma/historial; el
                      // contenido que respalda la firma no cambia en este write.
                      (resource.data.estado == 'borrador'
                       && request.resource.data.estado == 'firmada'
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['estado', 'firmado', 'firma_colaborador', 'firma_hash',
                                    'fecha_firma', 'historial', 'fecha_actualizacion'])
                       && request.resource.data.firmado == true
                       && contenidoActaEppValido(request.resource.data)
                       && request.resource.data.historial.size()
                            == resource.data.get('historial', []).size() + 1
                       && request.resource.data.historial[request.resource.data.historial.size() - 1].get('de', '') == 'borrador'
                       && request.resource.data.historial[request.resource.data.historial.size() - 1].get('a', '') == 'firmada')
                      ||
                      // ── ANULAR (borrador|firmada → anulada): SOLO marca +
                      // motivo + historial; firma, hash y contenido quedan
                      // tal cual (por eso no se re-valida el contenido).
                      (resource.data.estado in ['borrador', 'firmada']
                       && request.resource.data.estado == 'anulada'
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['estado', 'anulacion', 'historial', 'fecha_actualizacion'])
                       && anulacionActaEppValida(request.resource.data.anulacion)
                       && (!('fecha_actualizacion' in request.resource.data)
                           || request.resource.data.fecha_actualizacion is timestamp)
                       && request.resource.data.historial.size()
                            == resource.data.get('historial', []).size() + 1
                       && 'a' in request.resource.data.historial[request.resource.data.historial.size() - 1]
                       && 'de' in request.resource.data.historial[request.resource.data.historial.size() - 1])
                    );

      // Sin delete para NADIE (admin incluido): la baja es la anulación.
      allow delete: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // CATCH-ALL: denegar todo lo no especificado explícitamente
    // ────────────────────────────────────────────────────────────────
    // Incluye la colección `consecutivos` del SIGP: solo la Cloud
    // Function `generarConsecutivo` con Admin SDK puede leerla/escribirla.

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
