rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────
    // HELPERS
    // ────────────────────────────────────────────────────────────────

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAuthed() {
      return request.auth != null;
    }

    // Lee el rol del usuario, con fallback al campo legacy 'role'
    // (H-002 cerrado en datos, fallback cosmético pendiente).
    function rolActual() {
      return userData().get('rol', userData().get('role', ''));
    }

    // 1. Cualquier rol con acceso al panel web (lectura general de users)
    function esPersonalPanel() {
      return isAuthed() && rolActual() in [
        'sst', 'admin',
        'gerencia_general', 'gerencia_administrativa',
        'operacion_comercial', 'auxiliar_proyectos', 'director_proyectos',
        'residente_sst', 'gestion_integral'
      ];
    }

    // residente_obra (renombrado R2, antes residente_cliente): EMPLEADO NEG
    // con acceso restringido al cliente asignado — NO un acceso del cliente.
    // REGLA OPERATIVA: este rol JAMÁS entra a un helper existente (los de
    // arriba y abajo son listas blancas de personal interno) — nace pudiendo
    // NADA y cada permiso suyo será una cita EXPLÍCITA de este helper en los
    // matches del módulo de clientes (bloque F1 aparte). El claim que se
    // evalúa aquí lo deriva la CF sincronizarClaims del doc de users (la
    // fuente auditable); regresión permanente en rolResidente.test.ts.
    function esResidenteDe(clienteId) {
      return isAuthed()
             && request.auth.token.get('perfil', '') == 'residente_obra'
             && request.auth.token.get('cliente_id', '') == clienteId
             && request.auth.token.get('cliente_id', '') != '';
    }

    // 2. Roles que administran obras y contratistas (crear/editar).
    function puedeGestionarProyectos() {
      return isAuthed() && rolActual() in [
        'admin',
        'gerencia_general',
        'operacion_comercial', 'auxiliar_proyectos', 'director_proyectos'
      ];
    }

    // ── Aprobación de preliquidación con respaldo (23-jul-2026) ──
    // ¿Este write FIJA una aprobación? (escribe un aprobador nuevo/distinto;
    // RETIRARLA — la reversión de la corrección del Bloque 4 — no cuenta).
    function fijaAprobacionPreliq() {
      return request.resource.data.get('preliquidacion', {}).get('aprobada_por', '') != ''
          && request.resource.data.get('preliquidacion', {}).get('aprobada_por', '')
             != resource.data.get('preliquidacion', {}).get('aprobada_por', '');
    }
    function salvedadPreliq() {
      return request.resource.data.get('preliquidacion', {}).get('salvedad', '');
    }

    // 3. Administración de `users` (invitar, cambiar rol, aprobar cuentas).
    //    Ya NO gobierna `formularios`/`notificaciones` — ver
    //    puedeRevisarFormularios(). Reemplaza el viejo isSST() ampliado con
    //    gestion_integral.
    function puedeAdministrarSST() {
      return isAuthed() && rolActual() in [
        'sst', 'admin', 'gestion_integral'
      ];
    }

    // 4. Solo lectura del subsistema SST (gerencia_general con visión
    //    ejecutiva total)
    function puedeVerSSTSoloLectura() {
      return isAuthed() && rolActual() in ['gerencia_general'];
    }

    // 4.5. Revisión de la cola SST (read/update de `formularios` y
    //    `notificaciones`) ÚNICAMENTE. Deliberadamente separado de
    //    puedeAdministrarSST(), que queda acotado a la gestión de `users`:
    //    residente_sst revisa formularios sin ganar poder sobre usuarios.
    function puedeRevisarFormularios() {
      return isAuthed() && rolActual() in [
        'sst', 'admin', 'gestion_integral', 'residente_sst'
      ];
    }

    // 5. Acceso al módulo SIGP (lectura de colecciones comerciales/proyectos).
    //    Espeja ROLES_CON_ACCESO_SIGP de types/sigp/roles.ts.
    function accesoSIGP() {
      return isAuthed() && rolActual() in [
        'admin', 'gerencia_general', 'gerencia_administrativa',
        'operacion_comercial', 'director_proyectos', 'auxiliar_proyectos',
        'gestion_integral'
      ];
    }

    // 6. Módulo Compras (C1): registro de proveedores y su información
    //    bancaria. Marcela (gerencia_administrativa) opera; admin respalda.
    function gestionaCompras() {
      return isAuthed() && rolActual() in ['gerencia_administrativa', 'admin'];
    }

    // 9. Validador de horario / asistencia (#3, 07-ago): los REPORTES los
    //    ven todas las gerencias + admin (decisión Giovanny); la GESTIÓN
    //    (ausentismos, detalle médico) es solo de gerencia_administrativa +
    //    admin. Los registros de reloj no los escribe NADIE desde el panel.
    function veHorario() {
      return isAuthed() && rolActual() in [
        'gerencia_administrativa', 'gerencia_general', 'gestion_integral',
        'director_proyectos', 'admin'
      ];
    }
    function gestionaHorario() {
      return isAuthed() && rolActual() in ['gerencia_administrativa', 'admin'];
    }

    // 10. Mantenimiento de precios del catálogo NEG (#2b, 09-ago): quién
    //     CORRIGE o AJUSTA MASIVAMENTE precios ya existentes. El ALTA desde
    //     el cotizador (create) sigue abierta a puedeGestionarProyectos().
    function puedeMantenerCatalogo() {
      return isAuthed() && rolActual() in [
        'gerencia_general', 'director_proyectos', 'admin'
      ];
    }

    // 11. Módulo de ACTIVIDADES + sus propuestas económicas (F1/F1.2).
    //     Helper PROPIO del módulo (decisión de Giovanny, 18-ago-2026):
    //     operacion_comercial NO ve actividades ni propuestas — Karen está
    //     a cargo únicamente de licitaciones; la operación in-house de
    //     Claro no es su frente. Antes estas colecciones heredaban
    //     puedeGestionarProyectos() (que sí incluye comercial porque
    //     gobierna el dominio comercial); ese helper NO se toca — cada
    //     módulo trae el suyo. El residente entra por esResidenteDe.
    function gestionaActividades() {
      return isAuthed() && rolActual() in [
        'admin', 'gerencia_general', 'auxiliar_proyectos', 'director_proyectos'
      ];
    }

    // 11. Módulo Tareas (14-ago): asignar tareas A OTROS es de las gerencias
    //     + admin (misma lectura de "gerencias" que veHorario); cualquiera
    //     del panel se AUTO-asigna y pasa/recibe el balón.
    function puedeAsignarTareas() {
      return isAuthed() && rolActual() in [
        'gerencia_general', 'gerencia_administrativa',
        'director_proyectos', 'gestion_integral', 'admin'
      ];
    }

    // 7. Módulo Compras (C2): órdenes de compra — documento de EJECUCIÓN
    //    (costo operativo: jamás venta/utilidad). Lectura por lista explícita
    //    (mínimo privilegio): sin operacion_comercial ni sst — la OC no es
    //    comercial. `residente_obra` se sumará a crear/ver cuando exista el rol.
    function puedeCrearOC() {
      return isAuthed() && rolActual() in [
        'auxiliar_proyectos', 'director_proyectos', 'gerencia_general', 'admin'
      ];
    }
    function apruebaOC() {
      return isAuthed() && rolActual() in ['director_proyectos', 'gerencia_general', 'admin'];
    }
    function puedeVerOC() {
      return isAuthed() && rolActual() in [
        'auxiliar_proyectos', 'director_proyectos', 'gerencia_general',
        'gerencia_administrativa', 'gestion_integral', 'admin'
      ];
    }
    // ¿Este write FIJA la aprobación de la OC? (patrón fijaAprobacionPreliq:
    // escribir un aprobador nuevo/distinto; retirarlo no cuenta)
    function fijaAprobacionOC() {
      return request.resource.data.get('aprobada_por', '') != ''
          && request.resource.data.get('aprobada_por', '') != resource.data.get('aprobada_por', '');
    }

    // 8. §16 (07-ago): la frontera de comercial es la COTIZACIÓN — los
    //    proyectos son dominio de ejecución. operacion_comercial queda fuera
    //    de LEER y de CREAR proyectos; el nacimiento es de la CF
    //    crearProyectoAlAprobar (Admin SDK, patrón 3a de único escritor).
    function puedeVerProyectos() {
      return isAuthed() && rolActual() in [
        'admin', 'gerencia_general', 'gerencia_administrativa',
        'director_proyectos', 'auxiliar_proyectos', 'gestion_integral'
      ];
    }
    // Escotilla MANUAL de creación (gestores sin comercial). El creador
    // primario es la CF; esto queda para emergencias de admin/dirección.
    function puedeCrearProyectos() {
      return isAuthed() && rolActual() in [
        'admin', 'gerencia_general', 'director_proyectos', 'auxiliar_proyectos'
      ];
    }

    // 12. Módulo LICITACIONES — helper PROPIO del módulo (misma costumbre que
    //     gestionaActividades: cada módulo trae el suyo; ningún helper
    //     existente se toca). `operacion_comercial` ESTÁ dentro: las
    //     licitaciones son su frente (decisión de negocio del PR #97).
    function gestionaLicitaciones() {
      return isAuthed() && rolActual() in [
        'operacion_comercial', 'gerencia_general', 'gerencia_administrativa',
        'director_proyectos', 'admin'
      ];
    }

    // 13. ECONOMÍA de la licitación (subcolección): oferta de NEG, márgenes,
    //     análisis del precio. SIN `operacion_comercial` — quien arma la
    //     propuesta no ve el techo económico con el que se la evalúa. Mismo
    //     principio de mínimo privilegio que puedeVerOC.
    function veEconomiaLicitacion() {
      return isAuthed() && rolActual() in [
        'gerencia_general', 'gerencia_administrativa', 'director_proyectos',
        'admin'
      ];
    }

    // 14. Escritura del REGISTRO DEL CRITERIO del semáforo
    //     (`configuracion/semaforo_versiones`). Segregación de funciones:
    //     `operacion_comercial` LEE el criterio (vía el read de
    //     `configuracion/{docId}`) y no lo ESCRIBE — quien es medido por el
    //     criterio no lo redefine.
    function escribeCriterioSemaforo() {
      return isAuthed() && rolActual() in [
        'gerencia_general', 'gerencia_administrativa', 'admin'
      ];
    }

    // 15. Invariante 6 de licitaciones: los estados de COMPROMISO (donde NEG
    //     gasta horas) y los de RESULTADO exigen consecutivo. Los tres de
    //     triage — detectada, en_evaluacion, descartada — lo admiten vacío.
    //     Espeja ESTADOS_EXIGEN_CONSECUTIVO de types/sigp/licitacion.ts.
    function licExigeConsecutivo(estado) {
      return estado in [
        'en_preparacion', 'manifestada', 'presentada',
        'adjudicada', 'perdida', 'rechazada', 'revocada', 'desierta'
      ];
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: users
    // ────────────────────────────────────────────────────────────────

    match /users/{userId} {
      // Read: uno mismo, o cualquier rol con acceso al panel
      allow read: if isAuthed() && (
        request.auth.uid == userId || esPersonalPanel()
      );

      // Update self: puede editar su propio documento, pero NO cambiar
      // campos sensibles.
      allow update: if isAuthed()
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasAny(['rol', 'role', 'estado', 'aprobado', 'obras_asignadas']);

      // Create/update/delete administrativo: solo puedeAdministrarSST
      allow create, update, delete: if puedeAdministrarSST();

      // Create self: al registrarse en la app, SOLO puede crear su propio doc
      // con rol 'tecnico', estado 'pendiente', sin auto-aprobarse y sin
      // auto-asignarse obras (allowlist, no denylist — cierra el hueco de
      // auto-asignarse cualquier rol privilegiado, de saltarse la cola de
      // aprobación SST vía estado/aprobado, o de precargar obras propias).
      allow create: if isAuthed()
                    && request.auth.uid == userId
                    && request.resource.data.get('rol', 'tecnico') == 'tecnico'
                    && request.resource.data.get('role', 'tecnico') == 'tecnico'
                    && request.resource.data.get('estado', 'pendiente') == 'pendiente'
                    && request.resource.data.get('aprobado', false) == false
                    && request.resource.data.get('obras_asignadas', []) == [];
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: obras
    // ────────────────────────────────────────────────────────────────

    match /obras/{obraId} {
      // Read: cualquier usuario autenticado (comportamiento legacy). El panel
      // SST (hub de registros), la app Flutter y la sincronización de la
      // obra-espejo necesitan listar/leer obras. NO se toca (Hotfix A).
      allow read: if isAuthed();

      // Hotfix A (23-jul-2026): las obras NACEN del flujo SIGP (obra-espejo
      // con origen:'sigp' al entrar el proyecto en ejecución). La creación
      // manual suelta queda restringida a admin (escotilla de emergencia):
      // un gestor solo puede crear la espejo del flujo.
      allow create: if isAuthed() && (
        rolActual() == 'admin' ||
        (puedeGestionarProyectos() && request.resource.data.get('origen', '') == 'sigp')
      );

      // Update/delete: gestión de proyectos (la sincronización de la espejo
      // actualiza el estado en las transiciones del proyecto).
      allow update, delete: if puedeGestionarProyectos();
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: contratistas
    // ────────────────────────────────────────────────────────────────
    // Lectura pública justificada: el formulario de registro de
    // técnicos en la app SST necesita listar contratistas pre-login
    // (el selector solo muestra el nombre). C2.1 paso 5 — cierre
    // PARCIAL de H-001: la CÉDULA (dato personal, Ley 1581/2012) vive
    // en el sub-doc privado/datos y NO en este doc público; el NIT se
    // queda en el padre como riesgo aceptado (registro mercantil
    // público — y la app Flutter lo lee/escribe, línea roja no tocar).

    match /contratistas/{contratistaId} {
      allow read: if true;

      // Gestión completa (crear/editar/eliminar). C2.1 paso 5 fase 3: el
      // padre RECHAZA los campos de datos personales en create y update —
      // aunque un formulario futuro se equivoque, la cédula no puede volver
      // al doc público (la protección no depende de que ningún desarrollador
      // se equivoque nunca).
      allow create: if puedeGestionarProyectos()
                    && !request.resource.data.keys()
                        .hasAny(['cedula', 'telefono', 'direccion']);
      allow update: if puedeGestionarProyectos()
                    && !request.resource.data.diff(resource.data)
                        .affectedKeys().hasAny(['cedula', 'telefono', 'direccion']);
      allow delete: if puedeGestionarProyectos();

      // C2.1 paso 5: datos personales del contratista (cédula de persona
      // natural) — patrón sub-doc privado de proveedores (C1). Leen quienes
      // gestionan proyectos (asignación congela el documento) y gerencia
      // administrativa (tabla de contratistas / habilitación); escriben
      // solo los gestores (mismo camino del CRUD del padre).
      match /privado/{docId} {
        allow read: if puedeGestionarProyectos() || gestionaCompras();
        allow write: if puedeGestionarProyectos();
      }

      // gerencia_administrativa: habilitar/deshabilitar contratistas. SOLO puede
      // cambiar el campo `estado`. El panel (useFirestore) inyecta
      // `fecha_actualizacion` en cada update, así que se permite junto a `estado`.
      // No puede crear ni eliminar ni tocar ningún otro campo.
      allow update: if isAuthed()
                    && rolActual() == 'gerencia_administrativa'
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['estado', 'fecha_actualizacion']);
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: registros — INMUTABLE (auditoría a prueba de manipulación)
    // ────────────────────────────────────────────────────────────────

    match /registros/{registroId} {
      allow read: if isAuthed() && (
        puedeAdministrarSST() ||
        puedeVerSSTSoloLectura() ||
        resource.data.get('tecnicoId', '') == request.auth.uid
      );
      allow create: if isAuthed();
      allow update, delete: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: formularios
    // ────────────────────────────────────────────────────────────────

    match /formularios/{formularioId} {
      allow read: if isAuthed() && (
        puedeRevisarFormularios() ||
        puedeVerSSTSoloLectura() ||
        resource.data.get('user_id', '') == request.auth.uid
      );

      allow create: if isAuthed() &&
        request.resource.data.get('user_id', '') == request.auth.uid;

      // Update — dos vías:
      // 1) Revisores (puedeRevisarFormularios): sin restricción — son los
      //    ÚNICOS que fijan revision_sst.estado en 'aprobado'/'rechazado'.
      // 2) El DUEÑO del formulario (la app móvil): sus updates normales
      //    (guardar `data`, actualizar `pdf_url`/`pdf_storage_path`, etc.)
      //    siguen libres como siempre; PERO si el update toca `revision_sst`,
      //    el nuevo `revision_sst.estado` tiene que ser exactamente
      //    'pendiente'. El único caso legítimo de que el dueño toque
      //    `revision_sst` es el reenvío tras corrección (#4): la app escribe
      //    revision_sst → {estado:'pendiente', observacion:null,
      //    revisado_por:null} + corregido_en (+ revision_sst_historial via
      //    arrayUnion). Esto cierra el hueco de que un técnico pudiera
      //    auto-fijarse revision_sst.estado = 'aprobado' (auto-aprobación).
      allow update: if isAuthed() && (
        puedeRevisarFormularios() ||
        (resource.data.get('user_id', '') == request.auth.uid
          && (!request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['revision_sst'])
              || request.resource.data.get('revision_sst', {})
                   .get('estado', '') == 'pendiente'))
      );

      allow delete: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: contadores — consecutivos atómicos SST (app móvil)
    // ────────────────────────────────────────────────────────────────
    // Sin cambio. Sistema legacy de la app Flutter.

    match /contadores/{clave} {
      allow read, create, update: if isAuthed();
      allow delete: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: notificaciones — panel SST ↔ app móvil
    // ────────────────────────────────────────────────────────────────

    match /notificaciones/{notifId} {
      allow read: if isAuthed() && (
        puedeRevisarFormularios() ||
        puedeVerSSTSoloLectura() ||
        resource.data.get('user_id', '') == request.auth.uid
      );

      allow create: if isAuthed();

      allow update: if isAuthed() && (
        puedeRevisarFormularios() ||
        resource.data.get('user_id', '') == request.auth.uid
      );

      allow delete: if puedeAdministrarSST();
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: clientes (SIGP — Comercial, F1)
    // ────────────────────────────────────────────────────────────────
    // Read: cualquier rol con acceso al módulo SIGP.
    // Write: solo roles que gestionan proyectos/comercial.

    match /clientes/{clienteId} {
      // F1 Actividades: el residente lee SU cliente (sedes, solicitantes,
      // contratos — los necesita para operar actividades). Concesión
      // explícita vía esResidenteDe; jamás la lista interna.
      allow read: if accesoSIGP() || esResidenteDe(clienteId);
      allow create, update, delete: if puedeGestionarProyectos();
    }

    // ── Compras C1: proveedores (los materiales los compra NEG) ──────
    // Doc id = identificación normalizada. Identidad + rut_url visibles a
    // los operativos (C2: órdenes de compra); lo bancario VIVE en la
    // subcolección privada — las reglas no ocultan campos en lectura
    // (mismo principio que la proyección verificaciones_sst del 3a).
    // Sin delete: soft-delete por estado (restricción 5.1).
    match /proveedores/{proveedorId} {
      allow read: if accesoSIGP();
      // Proveedor nuevo exige el RUT ya subido (validación dura UI + regla).
      allow create: if gestionaCompras()
                    && request.resource.data.get('rut_url', '') != '';
      allow update: if gestionaCompras();

      // Datos bancarios + certificación bancaria: SOLO gerencia_administrativa
      // y admin (ni lectura para el resto del panel). El create exige cert +
      // banco + cuenta (sin cuenta no se le puede pagar); tipo_cuenta es duro
      // solo en UI. La creación ATÓMICA doc principal + este doc (un batch)
      // es responsabilidad del flujo de registro (C1 sub-bloque 2).
      match /privado/{docId} {
        allow read: if gestionaCompras();
        allow create: if gestionaCompras()
                      && request.resource.data.get('certificacion_bancaria_url', '') != ''
                      && request.resource.data.get('banco', '') != ''
                      && request.resource.data.get('numero_cuenta', '') != '';
        allow update: if gestionaCompras();
      }
    }

    // ── Compras C1: semilla de autocompletado de contactos ───────────
    // Solo lectura para quien registra proveedores; SIN write en reglas.
    // Se poblará más adelante con un wizard manual desde un Excel filtrado
    // (el seed por script se retiró del alcance de C1).
    match /contactos_lookup/{contactoId} {
      allow read: if gestionaCompras();
    }

    // ── Compras C2: órdenes de compra ────────────────────────────────
    // El consecutivo OC-YYYY-NNN se asigna al EMITIR (los borradores no
    // queman número — contigüidad ISO). La aprobación está blindada
    // por-campo: rol aprobador + aprobador ≠ creador (o salvedad
    // obligatoria — el escape GG-crea/GG-aprueba, con traza).
    match /ordenes_compra/{ocId} {
      allow read: if puedeVerOC();
      // Nace SIEMPRE como borrador y con el creador real (no suplantable).
      allow create: if puedeCrearOC()
                    && request.resource.data.get('estado', '') == 'borrador'
                    && request.resource.data.get('creada_por', '') == request.auth.uid;
      // Dos vías (C3): la OPERATIVA de siempre (crear/emitir/aprobar/anular)
      // y la de MARCELA (marcar comprada — SOLO eso, hasOnly) + su corrección.
      allow update: if (
                    // ── Vía OPERATIVA ──
                    puedeCrearOC()
                    // comprada = terminal para operativos (recepción = v2)
                    && resource.data.get('estado', '') != 'comprada'
                    && request.resource.data.get('estado', '') != 'comprada'
                    // aprobada = inmutable, salvo ANULARLA (solo aprobadores)
                    && (resource.data.get('estado', '') != 'aprobada'
                        || (apruebaOC() && request.resource.data.get('estado', '') == 'anulada'))
                    // anulada = terminal
                    && resource.data.get('estado', '') != 'anulada'
                    // EMITIR exige la cotización del proveedor ya adjunta
                    && (request.resource.data.get('estado', '') != 'emitida'
                        || resource.data.get('estado', '') == 'emitida'
                        || request.resource.data.get('cotizacion_proveedor_url', '') != '')
                    // APROBAR blindado por-campo
                    && (!fijaAprobacionOC()
                        || (apruebaOC()
                            && (request.auth.uid != resource.data.get('creada_por', '')
                                || request.resource.data.get('salvedad_aprobacion', '') != '')))
                    // a 'aprobada' SOLO desde 'emitida' y siempre fijando aprobador
                    && (request.resource.data.get('estado', '') != 'aprobada'
                        || resource.data.get('estado', '') == 'aprobada'
                        || (resource.data.get('estado', '') == 'emitida'
                            && request.resource.data.get('aprobada_por', '') != ''))
                    ) || (
                    // ── Vía MARCELA (C3): aprobada → comprada, con valor real
                    // pagado + soporte obligatorios. hasOnly: no puede tocar
                    // NADA más (líneas, proveedor, aprobación intactos).
                    gestionaCompras()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['estado', 'valor_real', 'soporte_compra_url',
                                  'comprada_por', 'fecha_compra', 'historial',
                                  'fecha_actualizacion'])
                    && resource.data.get('estado', '') == 'aprobada'
                    && request.resource.data.get('estado', '') == 'comprada'
                    && request.resource.data.get('valor_real', 0) > 0
                    && request.resource.data.get('soporte_compra_url', '') != ''
                    ) || (
                    // ── Corrección de compra (addendum C3): el ESTADO es
                    // terminal (no se "des-compra" — la reversa con
                    // devolución es recepción/v2) pero el MONTO registrado
                    // es corregible con traza — filosofía Hotfix B: corregir
                    // no se bloquea, se traza. La CF recalcula sola.
                    gestionaCompras()
                    && resource.data.get('estado', '') == 'comprada'
                    && request.resource.data.get('estado', '') == 'comprada'
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['valor_real', 'soporte_compra_url',
                                  'historial', 'fecha_actualizacion'])
                    && request.resource.data.get('valor_real', 0) > 0
                    );
      // sin delete — 'anulada' es el terminal suave (restricción 5.1)
    }

    // ── Compras C3: proyección del agregado de compras por proyecto ──
    // La escribe SOLO la CF sincronizarComprasProyecto (Admin SDK) — sin
    // ningún write de cliente: a prueba de manipulación por construcción
    // (patrón verificaciones_sst). Alimenta el indicador presupuestal (#3).
    // Lectura alineada con las OCs (§16/C2): sin sst ni operacion_comercial.
    match /compras_proyecto/{proyectoId} {
      allow read: if puedeVerOC();
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: lpus (+ subcolección items) — SIGP, Comercial, F1
    // ────────────────────────────────────────────────────────────────
    // Read: cualquier rol con acceso SIGP. Write: gestión de proyectos.
    // Los ítems (~900 por LPU) viven en la subcolección lpus/{id}/items.

    match /lpus/{lpuId} {
      // F1 Actividades: el residente lee las LPUs de SU cliente (el buscador
      // de líneas del alcance). El list exige where cliente_id == el suyo.
      allow read: if accesoSIGP() || esResidenteDe(resource.data.cliente_id);
      allow create, update, delete: if puedeGestionarProyectos();

      match /items/{itemId} {
        // Los ítems no llevan cliente_id: se resuelve por el doc PADRE
        // (get cacheado por request — un solo doc único por consulta).
        allow read: if accesoSIGP()
                    || esResidenteDe(get(/databases/$(database)/documents/lpus/$(lpuId)).data.cliente_id);
        allow create, update, delete: if puedeGestionarProyectos();
      }
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: solicitudes (SIGP — Comercial, F1)
    // ────────────────────────────────────────────────────────────────
    // Bandeja de entrada comercial. Read: acceso SIGP. Write: gestión de proyectos.

    match /solicitudes/{solicitudId} {
      allow read: if accesoSIGP();
      allow create, update, delete: if puedeGestionarProyectos();
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: visitas (SIGP — Comercial, F1 — levantamiento)
    // ────────────────────────────────────────────────────────────────
    // Read: acceso SIGP. Write: gestión de proyectos.

    match /visitas/{visitaId} {
      allow read: if accesoSIGP();
      allow create, update, delete: if puedeGestionarProyectos();
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: cotizaciones (+ subcolección versiones) — SIGP, Comercial, F1
    // ────────────────────────────────────────────────────────────────
    // Read: acceso SIGP. Write: gestión de proyectos. Cada versión (snapshot con
    // ítems inline) vive en la subcolección cotizaciones/{id}/versiones.

    match /cotizaciones/{cotizacionId} {
      allow read: if accesoSIGP();
      allow create, update, delete: if puedeGestionarProyectos();

      match /versiones/{versionId} {
        allow read: if accesoSIGP();
        allow create, update, delete: if puedeGestionarProyectos();
      }
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: catalogo_items — catálogo NEG de ítems propios (F1.4-B)
    // ────────────────────────────────────────────────────────────────
    // Read: acceso SIGP. Write: gestión de proyectos. El código CAT-NNNN lo
    // genera la Cloud Function generarConsecutivo (contador acumulativo).

    // #2b (09-ago): el ALTA sigue siendo del cotizador (incorporación con
    // CAT-NNNN — un setDoc sobre doc NUEVO, jamás update); el MANTENIMIENTO
    // posterior (update todo-o-nada: precio + historial) es solo de
    // gerencia_general/director_proyectos/admin. SIN delete: el soft-delete
    // por `estado` es el único retiro (restricción 5.1 — un ítem con
    // trazabilidad a cotizaciones no se borra físicamente).
    match /catalogo_items/{itemId} {
      allow read: if accesoSIGP();
      allow create: if puedeGestionarProyectos();
      allow update: if puedeMantenerCatalogo();
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: proyectos — SIGP, Ejecución, F2.1.a
    // ────────────────────────────────────────────────────────────────
    // Read: acceso SIGP. Write: gestión de proyectos. El doc nace al aprobar
    // una cotización (id del proyecto = id de la cotización → 1:1 idempotente);
    // el consecutivo PRY-YYYY-NNN lo genera la Cloud Function generarConsecutivo.

    match /proyectos/{proyectoId} {
      // Bloque 3a (ajuste de confidencialidad): SST NO lee proyectos —
      // contienen valor de venta, márgenes y preliquidación. Su cola vive
      // en la proyección delgada `verificaciones_sst` (más abajo).
      // §16 (07-ago): comercial FUERA — read por lista sin operacion_comercial;
      // create solo escotilla de gestores (el creador primario es la CF).
      allow read: if puedeVerProyectos();
      allow create: if puedeCrearProyectos();
      // Bloque final: un proyecto CERRADO es inmutable — tampoco se borra.
      // §16: delete por la misma vía que create/update (sin comercial) — lo
      // atrapó la batería SB4: sin read no hay delete coherente.
      allow delete: if puedeCrearProyectos()
                    && resource.data.get('estado', '') != 'cerrado';

      // Bloque 3a/3b: liquidar al contratista exige el aval SST leído de la
      // PROYECCIÓN (gate NO esquivable). El get() solo se evalúa al intentar
      // 'liquidado_contratista'; si la proyección no existe, deniega.
      // Bloque final: cerrado = INMUTABLE (ni gestores ni gerencia editan un
      // proyecto cerrado) y a `cerrado` SOLO se llega desde
      // `liquidado_contratista`.
      // Respaldo de aprobación (23-jul): los roles de PROYECTOS no aprueban
      // la preliquidación (definir y aprobar en la misma área rompe la
      // segregación); admin y gerencia_general SÍ, como RESPALDO, y su
      // aprobación exige salvedad.
      // Liquidación anticipada (23-jul) — MÁQUINA EXPLÍCITA hacia
      // liquidado_contratista: normal desde pagado_cliente; ANTICIPADA solo
      // desde facturado con marca + justificación (acuerdo con Gerencia de
      // Proyectos); ningún otro origen. El gate SST al_dia es INNEGOCIABLE
      // en ambas vías. El CIERRE exige el pago del cliente registrado (no
      // se cierra con cuenta por cobrar abierta).
      // §16: la vía operativa también sin comercial (sin read no hay
      // update coherente — evita el write a ciegas por id).
      allow update: if puedeCrearProyectos()
                    && resource.data.get('estado', '') != 'cerrado'
                    && (!fijaAprobacionPreliq()
                        || (rolActual() in ['admin', 'gerencia_general']
                            && salvedadPreliq() != ''))
                    && (request.resource.data.get('estado', '') != 'cerrado'
                        || (resource.data.get('estado', '') == 'liquidado_contratista'
                            && request.resource.data.get('pago_cliente', null) != null))
                    && (request.resource.data.get('estado', '') != 'liquidado_contratista'
                        || resource.data.get('estado', '') == 'liquidado_contratista'
                        || (get(/databases/$(database)/documents/verificaciones_sst/$(proyectoId))
                              .data.sst_gate.estado == 'al_dia'
                            && (resource.data.get('estado', '') == 'pagado_cliente'
                                || (resource.data.get('estado', '') == 'facturado'
                                    && request.resource.data.get('liquidacion', {}).get('liquidacion_anticipada', false) == true
                                    && request.resource.data.get('liquidacion', {}).get('justificacion_anticipada', '') != ''))));

      // Respaldo de aprobación (23-jul): gestion_integral SOLO aprueba la
      // preliquidación (hasOnly acotado) y siempre con salvedad. La titular
      // sigue siendo gerencia_administrativa (regla de abajo, sin salvedad).
      allow update: if isAuthed()
                    && rolActual() == 'gestion_integral'
                    && resource.data.get('estado', '') != 'cerrado'
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['preliquidacion', 'estado', 'historial', 'fecha_actualizacion'])
                    && fijaAprobacionPreliq()
                    && salvedadPreliq() != ''
                    && request.resource.data.get('estado', '') in ['preliquidacion_aprobada', 'anticipo_girado'];

      // F2.1.c — SEGREGACIÓN DE FUNCIONES: gerencia_administrativa aprueba la
      // preliquidación y registra el anticipo girado (quien define ≠ quien
      // desembolsa). Administrativa B1+B2 (22-jul-2026): además REGISTRA la
      // factura ('facturacion') y el pago del cliente ('pago_cliente').
      // B3b (23-jul-2026): + 'liquidacion' (cierre con el contratista) y
      // 'compras_reembolsos' — el SIGP registra, no ejecuta dinero. Sigue sin
      // poder tocar snapshot, asignación, alcance ni el resto del proyecto
      // (patrón hasOnly, como contratistas.estado). No crea ni elimina.
      // P2-2 (SB4): + 'resumen_asignaciones' — aprobar/girar POR ASIGNACIÓN
      // escribe el sub-doc y recalcula el resumen del padre en el MISMO batch.
      allow update: if isAuthed()
                    && rolActual() == 'gerencia_administrativa'
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['preliquidacion', 'facturacion', 'pago_cliente', 'liquidacion', 'compras_reembolsos', 'cierre', 'estado', 'historial', 'fecha_actualizacion', 'resumen_asignaciones'])
                    // Bloque final: cerrado inmutable + solo desde liquidado
                    // CON el pago del cliente registrado (no se cierra con
                    // cuenta por cobrar abierta — anticipada, 23-jul)
                    && resource.data.get('estado', '') != 'cerrado'
                    && (request.resource.data.get('estado', '') != 'cerrado'
                        || (resource.data.get('estado', '') == 'liquidado_contratista'
                            && request.resource.data.get('pago_cliente', null) != null))
                    // Bloque 3a/3b + anticipada (23-jul): liquidar exige el
                    // aval SST SIEMPRE; origen solo pagado_cliente (normal) o
                    // facturado (anticipada: marca + justificación). Un doc
                    // YA liquidado se puede seguir editando (p. ej. registrar
                    // el pago posterior) sin re-evaluar la transición.
                    && (request.resource.data.get('estado', '') != 'liquidado_contratista'
                        || resource.data.get('estado', '') == 'liquidado_contratista'
                        || (get(/databases/$(database)/documents/verificaciones_sst/$(proyectoId))
                              .data.sst_gate.estado == 'al_dia'
                            && (resource.data.get('estado', '') == 'pagado_cliente'
                                || (resource.data.get('estado', '') == 'facturado'
                                    && request.resource.data.get('liquidacion', {}).get('liquidacion_anticipada', false) == true
                                    && request.resource.data.get('liquidacion', {}).get('justificacion_anticipada', '') != ''))));

      // ── P2-2: asignaciones múltiples de contratista (SB5 endurecido) ──
      // Subcolección {aid} — cada asignación con su contratista, átomos,
      // preliquidación y liquidación PROPIAS. La economía baja del padre a
      // la asignación; el padre conserva `asignacion` (espejo de identidad)
      // y el caché `resumen_asignaciones`.
      //
      // ⚠ RIESGO CONOCIDO ACEPTADO (Giovanny, 03-sep): `resumen_asignaciones`
      // del padre es un CACHÉ y las reglas NO pueden validarlo contra la
      // subcolección (Firestore no consulta colecciones desde reglas) —
      // alguien con acceso de escritura podría dejarlo mintiendo. MITIGACIÓN:
      // la ficha (detectarDesincronizacion) compara resumen ↔ subcolección y
      // MUESTRA la discrepancia con botón de reparación — el control es la
      // detección visible, no la prevención imposible.
      match /asignaciones/{asignacionId} {
        allow read: if puedeVerProyectos();

        // CREATE — tres nacimientos, cada uno con su guardia:
        // (a) REGISTRO HISTÓRICO retroactivo (condición Giovanny 03-sep):
        //     afirmar "se pagó por fuera del panel" es una DECLARACIÓN DE
        //     GERENCIA — mismo perfil que aprueba preliquidaciones, con el
        //     motivo obligatorio validado AQUÍ (no solo en la UI) y la
        //     coherencia de nacer `liquidada` y marcada. Un gestor NO puede
        //     (el desvío del control de aprobación se cierra en reglas).
        // (b) MIGRACIÓN lazy/masiva: el sub-doc de id FIJO 'legacy' con la
        //     marca — UN solo cupo por proyecto (el id lo garantiza); lo
        //     dispara el primer write económico (gestores o gerencia).
        // (c) NORMAL: gestores; nace 'asignada' SIN economía ni marcas —
        //     aprobación/giro/liquidación llegan después por sus vías.
        allow create: if
          (request.resource.data.keys().hasAny(['registro_historico'])
            && isAuthed()
            && rolActual() in ['gerencia_administrativa', 'admin', 'gerencia_general', 'gestion_integral']
            && request.resource.data.get('registro_historico', {}).get('motivo', '') != ''
            && request.resource.data.get('estado', '') == 'liquidada')
          || (asignacionId == 'legacy'
            && request.resource.data.get('legacy', false) == true
            && (puedeCrearProyectos()
                || (isAuthed() && rolActual() == 'gerencia_administrativa')))
          || (puedeCrearProyectos()
            && request.resource.data.get('estado', '') == 'asignada'
            && !request.resource.data.keys().hasAny(
                 ['registro_historico', 'legacy', 'preliquidacion', 'liquidacion', 'cancelacion']));

        // UPDATE — dos vías POR CAMPO (espejo del padre):
        // GESTORES definen/corrigen/ajustan/cancelan/resuelven señal — JAMÁS
        // fijan aprobación (retirarla en la reversión sí), jamás CREAN un
        // anticipo (conservar el existente en una corrección sí), jamás
        // tocan las marcas ni llevan a 'liquidada' (liquidar es de gerencia).
        allow update: if
          (puedeCrearProyectos()
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['registro_historico', 'legacy'])
            && !fijaAprobacionPreliq()
            && (('anticipo' in resource.data.get('preliquidacion', {}).keys())
                || !('anticipo' in request.resource.data.get('preliquidacion', {}).keys()))
            && request.resource.data.get('estado', '') != 'liquidada')
          ||
          // GERENCIA (+ respaldo): aprueba/gira/liquida, acotada por-campo;
          // fijar aprobación exige la titular o salvedad escrita (PR #45).
          (isAuthed()
            && rolActual() in ['gerencia_administrativa', 'admin', 'gerencia_general', 'gestion_integral']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado', 'preliquidacion', 'liquidacion', 'compras_reembolsos', 'historial', 'fecha_actualizacion'])
            && (!fijaAprobacionPreliq()
                || rolActual() == 'gerencia_administrativa'
                || salvedadPreliq() != ''));
        // sin delete (cancelación = soft, restricción 5.1)
      }

      // ── Compras C3: compras menores del proyecto (sin OC) ──────────
      // Subcolección con reglas PROPIAS (no hereda del padre). Las registra
      // gerencia_administrativa/admin; el agregado de la CF las suma igual
      // que las OCs compradas. Sin delete (corrección por update — 5.1).
      match /compras_menores/{compraId} {
        allow read: if puedeVerOC();
        allow create, update: if gestionaCompras()
                              && request.resource.data.get('valor', 0) > 0;
      }
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: verificaciones_sst — Gate SST (Administrativa · Bloque 3a)
    // ────────────────────────────────────────────────────────────────
    // Proyección DELGADA del proyecto para el área SST: identidad + estado,
    // SIN datos financieros (SST no tiene acceso a `proyectos`). La escribe
    // la Cloud Function sincronizarVerificacionSst (Admin SDK — bypassa
    // reglas); el gate `sst_gate` lo posee SST. Gerencia/alta dirección la
    // leen para el chip del gate en su bandeja.

    match /verificaciones_sst/{proyectoId} {
      allow read: if isAuthed() && rolActual() in [
        'sst', 'residente_sst', 'admin',
        'gerencia_administrativa', 'gerencia_general'
      ];
      // sst/residente_sst marcan el gate — su ÚNICO campo de escritura
      // (patrón hasOnly, como contratistas.estado). Nadie más escribe el
      // gate; create/delete solo la Cloud Function.
      allow update: if isAuthed()
                    && rolActual() in ['sst', 'residente_sst']
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['sst_gate', 'historial', 'fecha_actualizacion']);
    }

    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: indicadores — Panel SIGP (ISO 9.1)
    // ────────────────────────────────────────────────────────────────
    // Registro MANUAL de indicadores de proceso cruzado (hoy: ind. 5
    // ambiental/SST, doc `sst_YYYY-MM`) mientras no exista integración
    // automática. Read: acceso SIGP. Write: gestión de proyectos.

    match /indicadores/{indicadorId} {
      allow read: if accesoSIGP();
      allow create, update: if puedeGestionarProyectos();
    }

    // ── Configuración de indicadores (Opción B, 07-ago): metas editables ──
    // Lectura: quien ve el tablero. Escritura: SOLO gerencia_general/admin.
    // Sin delete. Docs: configuracion/indicadores { meta_margen_pct } y
    // configuracion/horario { ips_oficina[], hora_fin_jornada } (#3 SB2 —
    // cubierto por esta MISMA regla genérica, sin cambio).
    match /configuracion/{docId} {
      allow read: if accesoSIGP();
      allow create, update: if isAuthed() && rolActual() in ['gerencia_general', 'admin'];
    }

    // #3 SB3 (ratificado 07-ago): el doc `horario` lo lee CUALQUIER autenticado —
    // el pop-up de fin de jornada aplica a TODOS los roles del panel (incl.
    // sst/residente_sst, fuera de accesoSIGP). Solo IPs de oficina + hora de
    // jornada (nada económico); `indicadores` conserva su regla de arriba.
    // La escritura NO se amplía (la cubre el match genérico: GG+admin).
    match /configuracion/horario {
      allow read: if isAuthed();
    }

    // Licitaciones 1.2 — REGISTRO DEL CRITERIO del semáforo.
    // Doc: configuracion/semaforo_versiones { versiones: {...}, version_actual }.
    // LECTURA: la da el match genérico de arriba (`accesoSIGP()`), que ya
    // incluye a operacion_comercial — no se re-declara aquí (patrón del match
    // `configuracion/horario`: cada bloque declara solo lo que AMPLÍA).
    // ESCRITURA: este match la extiende de [GG, admin] a
    // escribeCriterioSemaforo() = [GG, gerencia_administrativa, admin].
    // En Firestore los matches se UNEN, así que el resultado es exactamente
    // esa lista — y `operacion_comercial` sigue fuera por ambas vías.
    // Sin delete: el historial de versiones del criterio no se borra.
    match /configuracion/semaforo_versiones {
      allow create, update: if escribeCriterioSemaforo();
    }

    // ────────────────────────────────────────────────────────────────
    // MÓDULO HORARIO / ASISTENCIA (#3) — SB2 (07-ago-2026)
    // ────────────────────────────────────────────────────────────────
    // Eventos de reloj (ingreso/salida): los escribe SOLO la CF
    // registrarEventoHorario con Admin SDK — IP, dispositivo y timestamp
    // son server-side. Nadie "corrige el reloj" desde el panel: CERO
    // writes de cliente, explícito (patrón compras_proyecto).
    match /registros_horario/{registroId} {
      allow read: if veHorario();
      allow create, update, delete: if false;   // solo la CF (Admin SDK)
    }

    // Ausentismos (incapacidad / permiso / justificación / vacaciones):
    // los gestiona gerencia_administrativa (+admin); las gerencias los
    // leen para reportes. Soporte OBLIGATORIO al crear (patrón rut_url
    // de proveedores). Sin delete: anulación SOFT (estado + motivo, 5.1).
    match /ausentismos/{ausentismoId} {
      allow read: if veHorario();
      allow create: if gestionaHorario()
                    && request.resource.data.get('soporte_url', '') != '';
      allow update: if gestionaHorario();

      // Detalle médico (diagnóstico/observaciones) = dato de SALUD —
      // LÍNEA DURA (decisión Giovanny 07-ago): solo gerencia_administrativa
      // + admin; ni gerencia_general lo lee (patrón datos_bancarios).
      match /privado/{docId} {
        allow read, create, update: if gestionaHorario();
      }
    }

    // Módulo Tareas (14-ago): tareas con asignación y "balón en cancha".
    // Calco de ordenes_compra con TRES vías de update por `||`:
    //   asignador (editar/reasignar/anular — jamás cierra la tarea de otro)
    //   · asignado (por UID del doc — primera regla del SIGP autorizada por
    //     UID y no por rol; el balón lo pide por naturaleza)
    //   · receptor del balón (solo devolverlo).
    // `hecha`/`anulada` terminales sin reapertura (decisión SB1).
    // Sin delete — 'anulada' es el terminal suave (restricción 5.1).
    // ────────────────────────────────────────────────────────────────
    // COLECCIÓN: actividades — F1 de la operación in-house
    // ────────────────────────────────────────────────────────────────
    // Actividades de mantenimiento con dos hitos independientes
    // (aprobación / ejecución) y líneas de LPU por alcance. El RESIDENTE
    // OPERA (crea, edita, carga líneas, marca ambos hitos) pero SOLO
    // dentro de su cliente — el doble esResidenteDe del update impide
    // mover una actividad hacia o desde otro cliente. Sin segregación
    // interna entre hitos: la evidencia de la aprobación es la
    // referencia (aprobacion.referencia), no quién la teclea.
    // Sin delete: anulación soft con motivo (restricción 5.1).
    match /actividades/{actividadId} {
      allow read: if gestionaActividades() || gestionaCompras()
                  || esResidenteDe(resource.data.cliente_id);
      allow create: if gestionaActividades()
                    || esResidenteDe(request.resource.data.cliente_id);
      allow update: if gestionaActividades()
                    || (esResidenteDe(resource.data.cliente_id)
                        && esResidenteDe(request.resource.data.cliente_id));
      allow delete: if false;
    }

    // F1.2 — PROPUESTAS ECONÓMICAS de actividades: un doc por VERSIÓN
    // (patrón LPU vigente/historica; la re-emisión es un batch atómico que
    // historiza la anterior y re-apunta punteros). El RESIDENTE emite (negocia
    // con el gestor del cliente) acotado por su claim; el doble esResidenteDe
    // del update impide mover una propuesta entre clientes. Sin delete
    // (restricción 5.1) — las históricas se conservan con su PDF y su hash.
    // DECISIÓN DE NEGOCIO (Giovanny, 18-ago-2026): operacion_comercial NO
    // lee ni emite — vía gestionaActividades(), el helper propio del módulo
    // (ver su comentario). El pendiente que vivió aquí queda CERRADO.
    match /propuestas_actividad/{propuestaId} {
      allow read: if gestionaActividades()
                  || esResidenteDe(resource.data.cliente_id);
      allow create: if gestionaActividades()
                    || esResidenteDe(request.resource.data.cliente_id);
      allow update: if gestionaActividades()
                    || (esResidenteDe(resource.data.cliente_id)
                        && esResidenteDe(request.resource.data.cliente_id));
      allow delete: if false;
    }

    match /tareas/{tareaId} {
      allow read: if esPersonalPanel();

      // Nace SIEMPRE pendiente, con creador real no suplantable (patrón OC).
      // Asignador → a cualquiera; el resto del panel → SOLO a sí mismo.
      allow create: if isAuthed()
                    && request.resource.data.get('creada_por', '') == request.auth.uid
                    && request.resource.data.get('estado', '') == 'pendiente'
                    && request.resource.data.get('activa', false) == true
                    && request.resource.data.get('titulo', '') != ''
                    && request.resource.data.get('asignada_a', '') != ''
                    && (puedeAsignarTareas()
                        || (esPersonalPanel()
                            && request.resource.data.get('asignada_a', '') == request.auth.uid));

      allow update: if (
                    // ── Vía ASIGNADOR (o dueño de su AUTO-tarea) ──
                    (puedeAsignarTareas()
                     || (resource.data.get('creada_por', '') == request.auth.uid
                         && resource.data.get('asignada_a', '') == request.auth.uid))
                    && resource.data.get('estado', '') != 'hecha'
                    && resource.data.get('estado', '') != 'anulada'
                    && request.resource.data.get('creada_por', '')
                         == resource.data.get('creada_por', '')
                    // el asignador NO "hace" la tarea de otro: estado igual,
                    // o anulada, o pendiente (reasignación resetea)
                    && (request.resource.data.get('estado', '')
                          == resource.data.get('estado', '')
                        || request.resource.data.get('estado', '') in ['anulada', 'pendiente'])
                    // invariante del balón también en esta vía (anular /
                    // reasignar lo limpian; editar sin tocarlo lo conserva)
                    && (request.resource.data.get('estado', '') != 'en_espera'
                        || request.resource.data.get('balon_en', {}).get('uid', '') != '')
                    && (request.resource.data.get('estado', '') == 'en_espera'
                        || request.resource.data.get('balon_en', null) == null)
                    ) || (
                    // ── Vía ASIGNADO (autorizada por UID del doc) ──
                    isAuthed()
                    && resource.data.get('asignada_a', '') == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['estado', 'comentario_cierre', 'evidencia_url',
                                  'balon_en', 'historial', 'fecha_actualizacion', 'activa'])
                    && resource.data.get('estado', '') in ['pendiente', 'en_curso', 'en_espera']
                    && request.resource.data.get('estado', '') in ['en_curso', 'en_espera', 'hecha']
                    // cerrar exige comentario (+ evidencia si la tarea la pide)
                    && (request.resource.data.get('estado', '') != 'hecha'
                        || (request.resource.data.get('comentario_cierre', '') != ''
                            && (resource.data.get('requiere_evidencia', false) == false
                                || request.resource.data.get('evidencia_url', '') != '')))
                    // invariante del balón: en_espera ⟺ balon_en con uid
                    && (request.resource.data.get('estado', '') != 'en_espera'
                        || request.resource.data.get('balon_en', {}).get('uid', '') != '')
                    && (request.resource.data.get('estado', '') == 'en_espera'
                        || request.resource.data.get('balon_en', null) == null)
                    ) || (
                    // ── Vía RECEPTOR del balón: SOLO devolverlo ──
                    isAuthed()
                    && resource.data.get('estado', '') == 'en_espera'
                    && resource.data.get('balon_en', {}).get('uid', '') == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['estado', 'balon_en', 'historial', 'fecha_actualizacion', 'activa'])
                    && request.resource.data.get('estado', '') == 'en_curso'
                    && request.resource.data.get('balon_en', null) == null
                    );
      // sin delete — 'anulada' es el terminal suave (restricción 5.1)
    }

    // ────────────────────────────────────────────────────────────────
    // MÓDULO LICITACIONES (1.2) — procesos de SECOP
    // ────────────────────────────────────────────────────────────────
    // El documento vive en `types/sigp/licitacion.ts`; la máquina de estados y
    // las 5 invariantes las imponen los patch builders puros. Aquí se fijan
    // SOLO los invariantes que un cliente no puede falsear: quién entra, quién
    // dice ser, con qué estado nace y qué no se muta nunca.
    match /licitaciones/{licitacionId} {
      allow read: if gestionaLicitaciones();

      // Nace SIEMPRE 'detectada' y activa, con creador real no suplantable
      // (patrón OC/tareas). `numero_proceso` es la identidad del proceso en
      // SECOP y `semaforo_version` el criterio con que se clasificó: sin
      // ninguno de los dos el documento no es auditable.
      // CONSECUTIVO DIFERIDO (1.2b): nace VACÍO y se quema al materializar
      // (contigüidad ISO — un proceso detectado y descartado no gasta número).
      allow create: if gestionaLicitaciones()
                    && request.resource.data.get('creado_por', '') == request.auth.uid
                    && request.resource.data.get('estado', '') == 'detectada'
                    && request.resource.data.get('activa', false) == true
                    && request.resource.data.get('consecutivo', '') == ''
                    && request.resource.data.get('numero_proceso', '') != ''
                    && request.resource.data.get('semaforo_version', '') != '';

      // El actor no se suplanta; el creador es inmutable.
      allow update: if gestionaLicitaciones()
                    && request.resource.data.get('actualizado_por', '') == request.auth.uid
                    && request.resource.data.get('creado_por', '')
                         == resource.data.get('creado_por', '')

                    // Invariante 7: el consecutivo es inmutable una vez
                    // asignado. Exactamente dos casos legales — que no cambie,
                    // o la asignación inicial desde '' con el formato de la
                    // serie. Reescribir, limpiar o meter basura: denegado.
                    && (
                         request.resource.data.get('consecutivo', '')
                           == resource.data.get('consecutivo', '')
                         || (resource.data.get('consecutivo', '') == ''
                             && request.resource.data.get('consecutivo', '')
                                  .matches('^LIC-[0-9]{4}-[0-9]{4,}$'))
                       )

                    // `migrado` es inmutable: un histórico no se convierte en
                    // numerado ni al revés (1.3).
                    && request.resource.data.get('migrado', false)
                         == resource.data.get('migrado', false)

                    // Invariante 6: no se entra a un estado de compromiso o de
                    // resultado sin número. Como `request.resource.data` es el
                    // documento RESULTANTE, esto obliga a que el consecutivo
                    // viaje EN EL MISMO update que la transición — nunca queda
                    // un instante en `en_preparacion` sin número.
                    // EXCEPCIÓN de los MIGRADOS (1.3): los ~350 históricos
                    // entran en estados de resultado SIN número porque la serie
                    // no existía. Sin esta salida, CUALQUIER update sobre un
                    // histórico quedaría denegado para siempre.
                    && (request.resource.data.get('migrado', false) == true
                        || !licExigeConsecutivo(request.resource.data.get('estado', ''))
                        || request.resource.data.get('consecutivo', '') != '');

      // Sin delete — soft-delete vía `activa` (restricción 5.1). Denegado
      // incluso para admin: un proceso de SECOP no se borra, se descarta.

      // ── ECONOMÍA (subcolección): oferta, márgenes, análisis del precio ──
      // Este match NO hereda del padre: en Firestore un `match` de un
      // documento no cubre sus subcolecciones salvo con `{x=**}`, que aquí
      // deliberadamente NO se usa. `operacion_comercial` tiene read del padre
      // y NINGÚN acceso a esta subcolección — el test que importa es
      // justamente ese (actor de mínimo privilegio: autenticado, con acceso
      // pleno a la licitación, y 403 acá).
      // `create, update` en vez de `write`: SIN delete (restricción 5.1, cero
      // borrado físico). El análisis económico de un proceso es evidencia de
      // cómo se decidió una oferta — se corrige con una versión nueva, no se
      // borra. Denegado incluso para admin.
      match /economia/{docId} {
        allow read, create, update: if veEconomiaLicitacion();
      }
    }

    // ────────────────────────────────────────────────────────────────
    // CATCH-ALL: denegar todo lo no especificado explícitamente
    // ────────────────────────────────────────────────────────────────
    // Incluye la colección `consecutivos` del SIGP: solo la Cloud
    // Function `generarConsecutivo` con Admin SDK puede leerla/escribirla.

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
